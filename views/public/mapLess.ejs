    }, 2000); // Every 5 seconds (you can try 10000 = 10 sec if stable)

    function haversineDistance(lat1, lon1, lat2, lon2) {
  const R = 6371; // Earth radius in km
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLon = (lon2 - lon1) * Math.PI / 180;
  const a =
    Math.sin(dLat / 2) ** 2 +
    Math.cos(lat1 * Math.PI / 180) *
    Math.cos(lat2 * Math.PI / 180) *
    Math.sin(dLon / 2) ** 2;
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  return R * c; // Distance in km
}

function findBusPosition(stops, busLat, busLon) {
    for (let i = 0; i < stops.length - 1; i++) {
      const s1 = stops[i];
      const s2 = stops[i + 1];

      const d1 = haversineDistance(s1.latitude, s1.longitude, busLat, busLon);
      const d2 = haversineDistance(s2.latitude, s2.longitude, busLat, busLon);
      const dBetweenStops = haversineDistance(s1.latitude, s1.longitude, s2.latitude, s2.longitude);

      // if the sum of d1 + d2 ≈ dBetweenStops
      if (Math.abs((d1 + d2) - dBetweenStops) < 0.05) { // tolerance 50 meters
        return {
          between: [s1.stopName, s2.stopName],
          stop1: s1,
          stop2: s2,
          progress: d1 / dBetweenStops, // optional (0 to 1)
        };
      }
    }
    return null;
  }


  function findBetweenStops(stops, busLat, busLon) {
  // Step 1: find nearest stop
  let nearestIndex = 0;
  let minDist = Infinity;
  stops.forEach((stop, i) => {
    const d = haversine(busLat, busLon, stop.latitude, stop.longitude);
    if (d < minDist) {
      minDist = d;
      nearestIndex = i;
    }
  });

  // Step 2: determine direction
  const nextStop = stops[nearestIndex + 1];
  const prevStop = stops[nearestIndex - 1];
  let between = null;

  if (nextStop) {
    const distToNext = haversine(busLat, busLon, nextStop.latitude, nextStop.longitude);
    if (distToNext < minDist) between = [stops[nearestIndex].stopOrder, nextStop.stopOrder];
  }
  if (!between && prevStop) {
    const distToPrev = haversine(busLat, busLon, prevStop.latitude, prevStop.longitude);
    if (distToPrev < minDist) between = [prevStop.stopOrder, stops[nearestIndex].stopOrder];
  }

  return between
    ? `Bus is between ${between[0]} and ${between[1]}`
    : `Bus is near ${stops[nearestIndex].stopName}`;
}

