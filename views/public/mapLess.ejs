<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Map Less</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
  <style>
    .stopsContainer {
      position: relative;
      /* allows absolute positioning of child elements */
      height: 100%;
      /* your given height */
      width: 100%;
      /* example width, adjust as needed */


      padding: 0;


      border: 1px solid #ccc;
    }

    .card {
      position: absolute;
      /* allows precise placement */
      left: 50%;
      /* start from center horizontally */
      transform: translateX(-50%);
      /* center it perfectly */


      padding: 5px;
      background: white;
      border: 1px solid #333;
      text-align: center;
      border-radius: 5px;
    }

    .bus-line {
      stroke-dasharray: 6 6;
      animation: moveLine 2s linear infinite;
    }

    @keyframes moveLine {
      to {
        stroke-dashoffset: -12;
      }
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="row">
      <div class="col border">
        <button type="button" class="btn">Back</button>
      </div>
      <div class="col border d-flex justify-content-end">
        <!-- Driver and Conductor Information -->
        <div>
          <button class="btn" data-bs-toggle="modal" data-bs-target="#exampleModalToggle">
            D/C
          </button>

          <!-- Modal 1 -->
          <div class="modal fade" id="exampleModalToggle" aria-hidden="true" aria-labelledby="exampleModalToggleLabel" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content">
                <div class="modal-header">
                  <h1 class="modal-title fs-5" id="exampleModalToggleLabel">
                    Modal 1
                  </h1>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                  Show a second modal and hide this one with the button below.
                </div>
                <div class="modal-footer">
                  <button id="openModal2" class="btn btn-primary">
                    Open second modal
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Modal 2 -->
          <div class="modal fade" id="exampleModalToggle2" aria-hidden="true" aria-labelledby="exampleModalToggleLabel2" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content">
                <div class="modal-header">
                  <h1 class="modal-title fs-5" id="exampleModalToggleLabel2">
                    Modal 2
                  </h1>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                  Hide this modal and show the first with the button below.
                </div>
                <div class="modal-footer">
                  <button id="backToFirst" class="btn btn-primary">
                    Back to first
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- Button trigger modal -->
        <button type="button" class="btn" data-bs-toggle="modal" data-bs-target="#staticBackdrop">
          Bus Info
        </button>

        <!-- Modal -->
        <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header">
                <h1 class="modal-title fs-5" id="staticBackdropLabel">
                  Modal title
                </h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body">...</div>
              <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                  Close
                </button>
              </div>
            </div>
          </div>
        </div>
        <!-- Bus Info -->
      </div>
    </div>
    <div class="row">
      <div class="col border">
        <p class="border">UP304 (tmu to dhampur (<%=units  %> km))</p>
      </div>
    </div>



    <br>
    <br>

    <div class="row p-2 border position-relative">
      <!-- <div class="col border border-primary p-0" style="padding: <%= perUnitPix %>px !important;"> -->
      <div class="col border border-primary p-0">

        <!-- <div class="col border border-primary p-0" style="padding: 20px !important;"> -->

        <div class="stopsContainer">
          <% for (let index = 0; index < circle.length; index++) { %>
          <!-- Draw circle -->
          <%  const stop = circle[index]; %>


          <!-- Stop card -->
          <div class="position-absolute text-center shadow-none" style="top:<%= circle[index].totalUnitsSoFar * perUnitPix + 1.5*perUnitPix%>px;
         left:50%;
         transform:translateX(-50%);
         width: 80%;
         background: transparent;
         border: none;">

            <!-- Clickable stop name -->
            <div class="fw-semibold text-dark d-inline-flex align-items-baseline justify-content-center" style="font-size: clamp(0.8rem, 2.2vw, 1rem); cursor:pointer;" data-bs-toggle="modal" data-bs-target="#stopModal<%= index %>">
              <span class="text-truncate"><%= circle[index].name %></span>
              <span class="text-muted ms-1" style="font-size: 0.75em;">
                (<%= circle[index].distance %> km)
              </span>
            </div>
          </div>
          <!-- Modal -->
          <div class="modal fade" id="stopModal<%= index %>" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content border-0 shadow-sm rounded-3" style="font-family: 'Inter', 'Segoe UI', Roboto, sans-serif;">

                <!-- Header -->
                <div class="modal-header border-0 pb-0">
                  <h5 class="modal-title fw-semibold" style="font-size: 1.25rem; color: #222;">
                    <%= circle[index].name %>
                  </h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <!-- Body -->
                <div class="modal-body small text-muted" style="font-size: 0.95rem; line-height: 1.6;">
                  <p class="mb-2">
                    <strong class="text-dark" style="font-weight: 600;">Distance:</strong>
                    <span><%= circle[index].distance %> km</span>
                  </p>
                  <p class="mb-2">
                    <strong class="text-dark" style="font-weight: 600;">Arrival:</strong>
                    <span><%= circle[index].morningTime %></span>
                  </p>
                  <p class="mb-0">
                    <strong class="text-dark" style="font-weight: 600;">Departure:</strong>
                    <span><%= circle[index].eveningTime %></span>
                  </p>
                </div>

                <!-- Footer (optional subtle touch) -->
                <div class="modal-footer border-0 pt-0">
                  <button type="button" class="btn btn-light btn-sm px-3" data-bs-dismiss="modal" style="font-size: 0.9rem;">
                    Close
                  </button>
                </div>
              </div>
            </div>
          </div>




          <% } %>

        </div>
      </div>

      <div class="col border border-danger p-0">
        <svg id="svg" viewBox="0 0 3 <%=units + 4%>" height="<%=height %>px" preserveAspectRatio="none" width="100%" class="border">
          <!-- vertical lines -->
          <path stroke="black" stroke-width="2" vector-effect="non-scaling-stroke" d="M0 0 V100" />
          <path stroke="#0a57c0" stroke-width="10" vector-effect="non-scaling-stroke" d="M1.5 1 L1.5 1 1.5 <%=units + 3%>" stroke-linecap="round" />
          <path stroke="black" stroke-width="2" vector-effect="non-scaling-stroke" d="M3 0 V100" />

          <!--  Horizontal lines -->

          <% for (let index = 0; index <=units+4; index++) { %>
          <path stroke="black" stroke-width="2" vector-effect="non-scaling-stroke" d="M0 <%= index %> H100" />
          <% } %>


          <% for (let index = 0; index < circle.length; index++) { %>
          <!-- Draw circle -->
          <circle r="0.2" cx="<%= circle[index].x %>" cy="<%= circle[index].y %>" fill="red" />


          <image href="/busIcon.svg" x="1.25" y="1.5" width="0.5" height="1" id="bus" />


          <% } %>





        </svg>
      </div>
    </div>
    <br>
    <br>
    <br>
    <br>
  </div>




