  <script>
    // Handle "Open second modal"
    document
      .getElementById("openModal2")
      .addEventListener("click", function() {
        const modal1 = bootstrap.Modal.getInstance(
          document.getElementById("exampleModalToggle")
        );
        modal1.hide();

        // Wait until modal 1 is completely hidden, then show modal 2
        document.getElementById("exampleModalToggle").addEventListener(
          "hidden.bs.modal",
          () => {
            const modal2 = new bootstrap.Modal(
              document.getElementById("exampleModalToggle2")
            );
            modal2.show();
          }, {
            once: true
          }
        );
      });

    // Handle "Back to first"
    document
      .getElementById("backToFirst")
      .addEventListener("click", function() {
        const modal2 = bootstrap.Modal.getInstance(
          document.getElementById("exampleModalToggle2")
        );
        modal2.hide();

        // Wait until modal 2 is completely hidden, then show modal 1
        document.getElementById("exampleModalToggle2").addEventListener(
          "hidden.bs.modal",
          () => {
            const modal1 = new bootstrap.Modal(
              document.getElementById("exampleModalToggle")
            );
            modal1.show();
          }, {
            once: true
          }
        );
      });
  </script>
