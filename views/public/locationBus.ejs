<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- leaflet  css -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-SgOJa3DmI69IUzQ2PVdRZhwQ+dy64/BUtbMJw1MZ8t5HZApcHrRKUc4W0kG879m7"
      crossorigin="anonymous"
    />
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-k6d4wzSIapyDyv1kpU366/PK5hCdSbCRGRCMv+eplOQJWyd1fbcAu9OCUj5zNLiq"
      crossorigin="anonymous"
    ></script>
    <!-- leaflet  css -->
    <style>
      body,
      html {
        margin: 0;
        padding: 0;
        overflow: hidden;
        /* Prevent body from scrolling */
      }

      #map {
        width: 100%;
        height: 100vh;
        position: absolute;
        top: 0;
        left: 0;
      }

      .navbar {
        z-index: 1000;
      }
    </style>
    <title><%=bus.busNumber %></title>
  </head>

  <body>
    <div class="container">
      <nav
        class="navbar navbar-expand-lg bg-transparent position-relative"
        style="z-index: 1000"
      >
        <div class="container-fluid">
          <h3><strong><%=bus.busNumber %></strong></h3>
        </div>
      </nav>
    </div>

    <div id="map"></div>

    <!-- leaflet js  -->
    <script
      src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
      integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
      crossorigin=""
    ></script>

    <script src="https://unpkg.com/leaflet.marker.slideto/leaflet.marker.slideto.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <!-- leaflet js  -->
    <script>
                                    const bus = <%- JSON.stringify(bus) %>;

            const socket = io({
        query: {
          busId: bus._id.toString()
        },
        transports: ["websocket"],  // बहुत जरूरी — direct websocket connect
        reconnection: true,
        reconnectionAttempts: Infinity,
        reconnectionDelay: 5000,
        reconnectionDelayMax: 10000,
        timeout: 20000,
      });


      socket.on("connect_error", (err) => {
        console.error("❌ Socket connect error:", err.message);
      });


                                    setInterval(() => {
                                      socket.emit("💓"); // can be any light event like "ping" or "💓"
                                    }, 2000); // Every 5 seconds (you can try 10000 = 10 sec if stable)



                                    // Baser layers
                                    let googleStreets = L.tileLayer(
                                      "http://{s}.google.com/vt/lyrs=m&x={x}&y={y}&z={z}", {
                                        maxZoom: 20,
                                        subdomains: ["mt0", "mt1", "mt2", "mt3"],
                                      }
                                    );
                                    let googleHybrid = L.tileLayer(
                                      "http://{s}.google.com/vt/lyrs=s,h&x={x}&y={y}&z={z}", {
                                        maxZoom: 20,
                                        subdomains: ["mt0", "mt1", "mt2", "mt3"],
                                      }
                                    );
                                    let googleSat = L.tileLayer(
                                      "http://{s}.google.com/vt/lyrs=s&x={x}&y={y}&z={z}", {
                                        maxZoom: 20,
                                        subdomains: ["mt0", "mt1", "mt2", "mt3"],
                                      }
                                    );

                                    let googleTerrain = L.tileLayer(
                                      "http://{s}.google.com/vt/lyrs=p&x={x}&y={y}&z={z}", {
                                        maxZoom: 20,
                                        subdomains: ["mt0", "mt1", "mt2", "mt3"],
                                      }
                                    );
                                    var CartoDB_DarkMatter = L.tileLayer(
                                      "https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png", {
                                        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
                                        subdomains: "abcd",
                                        maxZoom: 20,
                                      }
                                    );


                                    var OpenStreetMap_HOT = L.tileLayer(
                                      "https://{s}.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png", {
                                        maxZoom: 20,
                                        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors, Tiles style by <a href="https://www.hotosm.org/" target="_blank">Humanitarian OpenStreetMap Team</a> hosted by <a href="https://openstreetmap.fr/" target="_blank">OpenStreetMap France</a>',
                                      }
                                    );
                                    var OpenStreetMap_France = L.tileLayer(
                                      "https://{s}.tile.openstreetmap.fr/osmfr/{z}/{x}/{y}.png", {
                                        maxZoom: 20,
                                        attribution: '&copy; OpenStreetMap France | &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                                      }
                                    );
                                    // Baser layers

                                    var baseMaps = {
                                      googleStreets,
                                      googleHybrid,
                                      googleSat,
                                      googleTerrain,


                                      OpenStreetMap_France,
                                      OpenStreetMap_HOT,
                                      CartoDB_DarkMatter,
                                    };



                                    var map = L.map("map", {
                                      center: [29.4426, 78.4327],
                                      zoom: 16,
                                      layers: [googleTerrain]
                                    });

                                    // Custom icon
                                    const BusIcon = L.Icon.extend({
                                      options: {
                                        iconSize: [60, 45],
                                        iconAnchor: [19, 45],
                                        popupAnchor: [0, -40]
                                      }
                                    });
                                    const busIcon = new BusIcon({
                                      iconUrl: bus.iconPhoto
                                    });

                                    // Marker + accuracy circle references
                                    let busMarker;
                                    let accuracyCircle;
                                    const busMarkerLayerGroup = L.layerGroup().addTo(map);

                                    // Fetch last location
                                    socket.emit("lastLocation", bus._id, (response) => {

                                      console.log(response)

                                      if (response.data) {
                                        const {
                                          latitude,
                                          longitude,
                                          accuracy
                                        } = response.data;

                                        // Marker
                                        busMarker = L.marker([latitude, longitude], {
                                          icon: busIcon
                                        });

                                        // Accuracy circle
                                        accuracyCircle = L.circle([latitude, longitude], {
                                          radius: accuracy || 50,
                                          color: "#3498db",
                                          fillColor: "#3498db",
                                          fillOpacity: 0.2,
                                          weight: 1
                                        });

                                        // Add both to map
                                        // Add popup
                                        const popupContent = getInfoPopupHTML(response.data.timestamp, accuracy);
                                        busMarker.bindPopup(popupContent)

                                        busMarkerLayerGroup.addLayer(busMarker);
                                        busMarkerLayerGroup.addLayer(accuracyCircle);

                                        map.flyTo([latitude, longitude], map.getZoom(), {
                                          animate: true,
                                          duration: 1.2
                                        });

                                      } else {
                                        console.log("Bus location is not available right now");
                                      }
                                    });

                                    // Handle live location updates
                                    socket.on("receivelocation", (data) => {
                                      console.log("📡 Live update:", data);
                                      const {
                                        latitude,
                                        longitude,
                                        accuracy,
                                        speed
                                      } = data;




                                      if (busMarker) {
                                        // Update marker position
                                        busMarker.slideTo([latitude, longitude], {
                                          duration: 1000
                                        });

                                        const popupContent = getInfoPopupHTML(data.timestamp, accuracy);
                                        busMarker.bindPopup(popupContent)

                                        // Update accuracy circle position & radius
                                        if (accuracyCircle) {
                                          accuracyCircle.setLatLng([latitude, longitude]);
                                          accuracyCircle.setRadius(accuracy || 50);
                                        }

                                        // Animate map if distance moved is significant
                                        const lastLatLng = busMarker.getLatLng();
                                        const moved = map.distance(lastLatLng, L.latLng(latitude, longitude));
                                        if (moved > 10) {
                                          map.flyTo([latitude, longitude], map.getZoom(), {
                                            animate: true,
                                            duration: 1.2
                                          });
                                        }

                                      } else {
                                        // Create new marker + circle if not already added
                                        busMarker = L.marker([latitude, longitude], {
                                          icon: busIcon
                                        });
                                        accuracyCircle = L.circle([latitude, longitude], {
                                          radius: accuracy || 50,
                                          color: "#3498db",
                                          fillColor: "#3498db",
                                          fillOpacity: 0.2,
                                          weight: 1
                                        });

                                        busMarkerLayerGroup.addLayer(busMarker);
                                        busMarkerLayerGroup.addLayer(accuracyCircle);
                                        const popupContent = getInfoPopupHTML(data.timestamp, accuracy);
                                        busMarker.bindPopup(popupContent)

                                        map.flyTo([latitude, longitude], map.getZoom(), {
                                          animate: true,
                                          duration: 1.2
                                        });
                                      }

                                       if (speed !== undefined && speed !== null) {
                                         ChangeLayer(data);
                                          }





                                    });

                                           //  Setting up Stops layer
                                    const iconStopLayerGroup = L.layerGroup().addTo(map);
                                    const circularStopLayerGroup = L.layerGroup().addTo(map)

                  async function ChangeLayer(data) {
                    const { latitude, longitude, speed } = data;

                    // Clear previous stop icons before re-adding
                    iconStopLayerGroup.clearLayers();

                    bus.routeStops.forEach(stop => {
                      const distance = getDistance(latitude, longitude, stop.latitude, stop.longitude);
                      const currentSpeed = speed > 0 ? speed : 0.001;
                      const timeMinutes = (distance / currentSpeed) * 60;
                      const etaText = timeMinutes < 1 ? "<1 min" : `${timeMinutes.toFixed(1)} min`;

                      const popupContent = `
                        <div style="padding:8px; border-radius:8px; background-color:#f8f9fa; box-shadow:0 2px 6px rgba(0,0,0,0.15); font-family:Arial; font-size:14px;">
                          <h4 style="margin:0 0 5px;">🚌 ${stop.stopName}</h4>
                          <p style="margin:2px 0;">🌅 <strong>Morning:</strong> ${stop.morningTime}</p>
                          <p style="margin:2px 0;">🌇 <strong>Evening:</strong> ${stop.eveningTime}</p>
                          <p style="margin:2px 0; color:#2a5298;"><strong>ETA:</strong> ${etaText}</p>
                        </div>
                      `;

                      const stopIcon = new stopIconClass({
                        iconUrl: '/assets/images/faces/bus-stop.png'
                      });

                      const iconMarker = L.marker([stop.latitude, stop.longitude], { icon: stopIcon })
                                          .bindPopup(popupContent);

                      iconStopLayerGroup.addLayer(iconMarker);
                    });
                  }





                                      function getDistance({ lat1, lon1, lat2, lon2 }) {
                                const R = 6371000; // Earth's radius in meters
                                const toRad = (deg) => (deg * Math.PI) / 180;

                                const φ1 = toRad(lat1);
                                const φ2 = toRad(lat2);
                                const Δφ = toRad(lat2 - lat1);
                                const Δλ = toRad(lon2 - lon1);

                                const a =
                                  Math.sin(Δφ / 2) ** 2 + Math.cos(φ1) * Math.cos(φ2) * Math.sin(Δλ / 2) ** 2;

                                const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));

                                const distanceInMeters = R * c;
                                return Math.floor(distanceInMeters); // rounded down to nearest meter
                              }






                                    function getInfoPopupHTML(timestamp, accuracy) {
                                      const formattedTime = new Date(timestamp).toLocaleString();

                                      return `
                                                          <div style="font-family: 'Segoe UI', sans-serif; font-size: 13px; padding: 6px;">
                                                            <div><strong>🕒 Last updated:</strong> ${formattedTime}</div>
                                                            <div><strong>📍 Accuracy:</strong> ±${Math.round(accuracy || 50)} meters</div>
                                                          </div>
                                                        `;
                                    }




                                    const stopIconClass = L.Icon.extend({
                                      options: {
                                        iconSize: [60, 45],
                                        iconAnchor: [19, 45],
                                        popupAnchor: [0, -40]
                                      }
                                    });

                                    bus.routeStops.forEach(stop => {
                                      console.log(stop)
                                      const stopIcon = new stopIconClass({
                                        iconUrl: '/assets/images/faces/bus-stop.png'
                                      });
                                      const popupContent = `
                                                                                                                           <div style="padding: 8px; border-radius: 8px; background-color: #f8f9fa; box-shadow: 0 2px 6px rgba(0,0,0,0.15); font-family: Arial; font-size: 14px;">
                                                                                                                             <h4 style="margin: 0 0 5px;">🚌 ${stop.stopName}</h4>
                                                                                                                             <p style="margin: 2px 0;">🌅 <strong>Morning:</strong> ${stop.morningTime}</p>
                                                                                                                             <p style="margin: 2px 0;">🌇 <strong>Evening:</strong> ${stop.eveningTime}</p>
                                                                                                                           </div>



                                                                                                                         `;


                                      var iconMarker = L.marker([stop.latitude, stop.longitude], {
                                        icon: stopIcon
                                      }).bindPopup(popupContent)
                                      const circleMarker = L.circleMarker([stop.latitude, stop.longitude], {
                                        radius: 20, // radius in pixels
                                        color: 'red',
                                        fillColor: '#f03',
                                        fillOpacity: 0.3
                                      })


                                      iconStopLayerGroup.addLayer(iconMarker);
                                      circularStopLayerGroup.addLayer(circleMarker)


                                    })
                                    //  Setting up Stops layer

                                    // over lyaer
                                    const overlays = {
                                      "iconStops": iconStopLayerGroup,
                                      "circularStops": circularStopLayerGroup,
                                      "busMarker": busMarkerLayerGroup

                                    };
                                    // over lyaer


                                    L.control.layers(baseMaps, overlays, {
                                      position: 'topleft' // or 'topleft', 'topright', 'bottomright'
                                    }).addTo(map);
    </script>
    <script
      src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
      integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
      crossorigin="anonymous"
    ></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.min.js"
      integrity="sha384-VQqxDN0EQCkWoxt/0vsQvZswzTHUVOImccYmSyhJTp7kGtPed0Qcx8rK9h9YEgx+"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
