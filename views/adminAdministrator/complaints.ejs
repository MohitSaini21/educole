<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <title>Complaint</title>
    <!-- plugins:css -->
    <link
      rel="stylesheet"
      href="/assets/vendors/mdi/css/materialdesignicons.min.css"
    />
    
    <link rel="stylesheet" href="/assets/vendors/css/vendor.bundle.base.css" />
    <!-- endinject -->
    <!-- Plugin css for this page -->
    <!-- End Plugin css for this page -->
    <!-- inject:css -->
    <!-- endinject -->
    <!-- Layout styles -->
    <link rel="stylesheet" href="/assets/css/style.css" />
    <!-- End layout styles -->

    
    <style>
        .fade-out {
  opacity: 0;
  transition: opacity 0.5s ease;
}
        .selected-col-blur {
    filter: blur(2px);
    transition: all 0.3s ease;
  }
      a {
        text-decoration: none; /* Remove underline by default */
      }
      
      a:hover {
        text-decoration: none; /* Remove underline on hover */
      }
    </style>
      <link rel="stylesheet" href="/assets/loader.css" />



    
  </head>
  <body>
    <div class="container-scroller">
      <!-- partial:../.../corePartials/_sidebar.html -->

      <%- include('../corePartials/sidebar.ejs') %>
     
      <!-- partial -->
      <div class="container-fluid page-body-wrapper">
        <!-- partial:../.../corePartials/_navbar.html -->

        <%- include('../corePartials/nav.ejs') %>
        <!-- partial -->
        <div class="main-panel">
          <div class="content-wrapper">

            <ul class="nav justify-content-end">
                <li class="nav-item">
                    <a class="nav-link <%= submitterType === 'parent' ? 'disabled active' : '' %>" 
                       href="/admin/complaints?by=parent" 
                       aria-disabled="<%= submitterType === 'parent' %>">P&S</a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link <%= submitterType === 'operator' ? 'disabled active' : '' %>" 
                       href="/admin/complaints?by=operator" 
                       aria-disabled="<%= submitterType === 'operator' %>">D&C</a>
                  </li>
                  
   
                
              </ul>

              <h3>Complaints (<%=submitterType%>)</h3>
              <br>


    
            <!-- Modal  -->
   
            <div class="modal fade" id="mediaModal" tabindex="-1" aria-hidden="true">
              <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content bg-dark text-white">
                  <div class="modal-header">
                    <h5 class="modal-title">📁 Media Preview</h5>
                    <button class="btn btn-outline-light mt-3" onclick="closeMediaModal()">
                      ❌ Close Preview
                    </button>
                    
                  </div>
                  <div class="modal-body text-center" id="mediaContainer">
                    <!-- Media will be injected here -->
                  </div>
                </div>
              </div>
            </div>
            
          

                <div class="row" id="mainRow">  

                    <% if (complaints && complaints.length > 0) { %>
                        <div class="col-12 grid-margin stretch-card" id="searchBus">
                          <div class="card">
                            <div class="card-body">
                              <h4 class="card-title">Vehicle Search</h4>
                              <p class="card-description">
                                Please enter the vehicle number below to search. You may input either the full or partial number. Example: <code>DL01AB1234</code>
                              </p>
                              <form class="form-inline" id="vehicleSearchForm">
                                <label class="sr-only" for="vehicleNumber">Vehicle Number</label>
                                <input
                                  type="text"
                                  class="form-control mb-2 mr-sm-2"
                                  id="vehicleNumber"
                                  placeholder="Enter Vehicle Number"
                                  required
                                />
                        
                                
                              </form>
                        
                              <div id="searchResult" class="mt-3 text-muted">
                                <!-- Dummy result or instructions can be rendered here -->
                                <small>Note: Only registered vehicle numbers will yield results.</small>
                              </div>
                            </div>
                          </div>
                        </div>
                        
                    
                    <% complaints.forEach(function(complaint) { %>
                        <div class="col-xl-4 col-md-6 grid-margin stretch-card complaints" id="<%= complaint.busNumber %>">
                          <div class="card shadow-sm border border-primary" id="<%=complaint._id  %>">
                            <div class="card-body">
                      
                              <!-- Complaint Type -->
                              <% if (complaint.complaintType) { %>
                                <h5 class="text-light font-weight-bold mb-3">
                                  📝 Complaint Type: <%= complaint.complaintType %>
                                </h5>
                              <% } %>
                      
                              <!-- Bus Number -->
                              <% if (complaint.busNumber) { %>
                                <p class="mb-2">🚌 <strong>Bus Number:</strong> <%= complaint.busNumber %></p>
                              <% } %>
                      
                              <!-- Submitted At -->
                              <% if (complaint.createdAt) { %>
                                <p class="mb-2">
                                  🗓️ <strong>Submitted At:</strong><br>
                                  <%= new Date(complaint.createdAt).toLocaleString("en-IN", {
                                    day: "2-digit",
                                    month: "short",
                                    year: "numeric",
                                    hour: "2-digit",
                                    minute: "2-digit"
                                  }) %>
                                </p>
                              <% } %>
                      
                              <!-- Incident Time -->
                              <% if (complaint.incidentTime) { %>
                                <p class="mb-2">
                                  ⏱️ <strong>Incident Time:</strong><br>
                                  <%= new Date(complaint.incidentTime).toLocaleString("en-IN") %>
                                </p>
                              <% } %>
                      
                              <!-- Description -->
                              <% if (complaint.description) { %>
                                <p class="mb-2">
                                  🗒️ <strong>Description:</strong><br>
                                  <%= complaint.description %>
                                </p>
                              <% } %>
                              <br>
                      
                              <!-- Media Preview -->
                              <% if (complaint.media) { 
                                const ext = complaint.media.split('.').pop().toLowerCase();
                              %>
                                <div class="mb-3">
                                  <strong>📎 Attached Media:</strong><br>
                                  <button 
                                  class="btn btn-sm btn-outline-info"
         onclick="showMediaModal('<%= complaint.media.replace(/\\/g, '/') %>', '<%= ext %>')" >
                                  🔍 Preview Media
                                </button>
                                </div>
                              <% } %>
                              
                      
                 
                              
                              <!-- Delete Button -->
                              <button onclick="deleteComplaint('<%= complaint._id %>', this)" class="btn btn-sm btn-danger mt-3">
                                🗑️ Delete Complaint
                              </button>
                              
                      
                            </div>
                          </div>
                        </div>
                      <% }) %>

                      <% } else { %>

  
                        <p class="card-description mt-3 ml-2 px-2 py-1 text-muted">
                          No Complaint has been registered  by <%=submitterType  %>.
        
                        </p>
                        
                      <% } %>
                      
                    


                  






              </div>
        
              
       

            
          <!-- content-wrapper ends -->
          <!-- partial:../.../corePartials/_footer.html -->
        <!-- <%- include('../corePartials/footer.ejs') %> -->
          <!-- partial -->
        </div>
        <!-- main-panel ends -->
      </div>
      <!-- page-body-wrapper ends -->
    </div>
    <%- include('../corePartials/loader.ejs') %>
    <!-- container-scroller -->
    <!-- plugins:js -->
    <script src="/assets/vendors/js/vendor.bundle.base.js"></script>
    <!-- endinject -->
    <!-- Plugin js for this page -->
    <!-- End plugin js for this page -->
    <!-- inject:js -->
    <script src="/assets/js/off-canvas.js"></script>
    <script src="/assets/js/hoverable-collapse.js"></script>
    <script src="/assets/js/misc.js"></script>
    <script src="/assets/js/settings.js"></script>
    <scrip src="/assets/js/todolist.js"></script>
    <!-- endinject -->
    <!-- Custom js for this page -->
         <!-- custom Script -->
    


      
  
    <script>
      if(document.getElementById("vehicleNumber")){

        document.addEventListener("DOMContentLoaded", function () {
          const vehicleInput = document.getElementById("vehicleNumber");
          const mainRow = document.getElementById("mainRow");
          const resultBox = document.getElementById("searchResult");
          vehicleInput.addEventListener("input", function () {
            let inputValue = this.value.trim();
            inputValue=inputValue.toLowerCase(  )
            
            if (inputValue.length > 0) {
                   // Example: show a live message below input
              resultBox.innerText = `Looking up results for: "${inputValue}"`;
              let complaints=document.getElementsByClassName("complaints")
              Array.from(complaints).forEach((element) => {
    // Convert element ID to lowercase for case-insensitive match
    const elementId = element.id.toLowerCase();
  
    if (elementId.includes(inputValue)) {
  
      
      mainRow.removeChild(element);
      mainRow.insertBefore(element, mainRow.children[1]); // 2nd position
      
    } 
    
    });
     
              
      
       
            } else {
       
              
              document.getElementById("searchResult").innerHTML = "     <small>Note: Only registered vehicle numbers will yield results.</small>";
            }
          });
        });

      }



  async function deleteComplaint(id, btnElement) {
    if (!confirm("Do you really want to delete this complaint?")) return;

    // Change button text and disable it
    const originalText = btnElement.innerHTML;
    btnElement.innerHTML = "⏳ Deleting...";
    btnElement.disabled = true;
    document.getElementById("loader").style.display = "flex";
    try {
      const res = await fetch(`/admin/deleteComplaint/${id}`, {
        method: "DELETE",
      });

      const result = await res.json();

      if (res.ok) {
        alert(result.message);
        document.getElementById("loader").style.display = "none";

        const child = document.getElementById(id);
        if (child) {
          const card = child.closest(".col-xl-4"); // Adjust class if needed
          if (card) {
            card.classList.add("fade-out");
            setTimeout(() => {
              card.remove();
            }, 500);
          }
        }
      } else {
        throw new Error(result.message || "Failed to delete complaint");
      }
    } catch (error) {
      console.error(error.message);
      document.getElementById("loader").style.display = "none";
      alert("❌ Network error: Could not delete complaint");
      // Revert button state
      btnElement.innerHTML = originalText;
      btnElement.disabled = false;
    }
  }



function closeMediaModal() {
  const modalEl = document.getElementById('mediaModal');
  modalEl.classList.remove('show');
  modalEl.style.display = 'none';
  document.body.classList.remove('modal-open');
  document.querySelector('.modal-backdrop')?.remove();
  document.getElementById('mediaContainer').innerHTML = '';
}




  function showMediaModal(mediaUrl, ext) {
    const container = document.getElementById("mediaContainer");
    container.innerHTML = ""; // Clear previous

    ext = ext.toLowerCase();

    if (["jpg", "jpeg", "png", "webp", "gif"].includes(ext)) {
      container.innerHTML = `<img src="${mediaUrl}" class="img-fluid rounded border" style="max-height: 400px; object-fit: contain;" />`;
    } else if (["mp4", "webm", "ogg"].includes(ext)) {
      container.innerHTML = `<video controls style="width: 100%; max-height: 400px;" class="rounded border"><source src="${mediaUrl}" type="video/${ext}">Your browser does not support video.</video>`;
    } else if (["mp3", "wav", "ogg"].includes(ext)) {
      container.innerHTML = `<audio controls style="width: 100%;"><source src="${mediaUrl}" type="audio/${ext}">Your browser does not support audio.</audio>`;
    } else {
      container.innerHTML = `<a href="${mediaUrl}" target="_blank">📁 Open Media</a>`;
    }

    const modal = new bootstrap.Modal(document.getElementById("mediaModal"));
    modal.show();
  }


  window.onload = function () {
        document.getElementById("loader").style.display = "none";
      };

</script>
<script type="module" src="/foreground.js"></script>

    <!-- custom Script -->
    <!-- End custom js for this page -->
  </body>
</html>
