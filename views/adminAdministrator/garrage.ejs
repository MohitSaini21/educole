    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const vehicleInput = document.getElementById("vehicleNumber");
        const mainRow = document.getElementById("mainRow");
        const resultBox = document.getElementById("searchResult");
        vehicleInput.addEventListener("input", function () {
          let inputValue = this.value.trim();
          inputValue=inputValue.toLowerCase(  )
          
          if (inputValue.length > 0) {
                 // Example: show a live message below input
            resultBox.innerText = `Looking up results for: "${inputValue}"`;
            let buses=document.getElementsByClassName("buses")
            Array.from(buses).forEach((element) => {
  // Convert element ID to lowercase for case-insensitive match
  const elementId = element.id.toLowerCase();

  if (elementId.includes(inputValue)) {

    
    mainRow.removeChild(element);
    mainRow.insertBefore(element, mainRow.children[1]); // 2nd position
    
  } 
  
  });
   
            
    
     
          } else {
     
            
            document.getElementById("searchResult").innerHTML = "     <small>Note: Only registered vehicle numbers will yield results.</small>";
          }
        });
      });
    </script>

 
 <script>
   const selectedIds = [];
  document.addEventListener("DOMContentLoaded", function () {

  // Get all elements with class "buses"
  const cols = document.getElementsByClassName("buses");

  // Convert HTMLCollection to array to use forEach
  Array.from(cols).forEach((col) => {
    col.addEventListener("dblclick", function () {
      const colId = this.id;

      // Toggle selection
      const isSelected = selectedIds.includes(colId);

      if (isSelected) {
        // Remove selection
        this.classList.remove("selected-col-blur");
        selectedIds.splice(selectedIds.indexOf(colId), 1);
      } else {
        // Add selection
        this.classList.add("selected-col-blur");
        selectedIds.push(colId);
      }

      console.log("Selected IDs:", selectedIds);
    });
  });
});

function ChangeStatus(param) {

  

  if (param === "Operational" || param === "Out of Service") {
    if (selectedIds.length === 0) {
      alert("Please select vehicles by clicking on them");
    } else {
      const data = {
        selectedIds: selectedIds,  // send the array of selected IDs
        status: param      // send the status param
      };
      document.getElementById("loader").style.display = "flex";
      fetch("/admin/changeStatus", {
        method: "POST",
        credentials: "same-origin",

        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(data),
      })
      .then(async (response) => {
        const responseData = await response.json();
        if(!responseData.success){
          document.getElementById("loader").style.display = "none";
          alert(responseData.error)


        }else{
          document.getElementById("loader").style.display = "none";

          const cols = document.getElementsByClassName("buses");
  
          




Array.from(cols).forEach((col) => {
  const colId = col.id;  // not this.id — "this" doesn't refer to col here

  if (selectedIds.includes(colId)) {
    col.remove();  // remove element from DOM

    // remove colId from selectedIds array
    const index = selectedIds.indexOf(colId);
    if (index > -1) {
      selectedIds.splice(index, 1);  // remove it from the array
    }
  }
});

if (Array.from(cols).length == 0) {

  
const searchElement = document.getElementById("searchBus");
if (searchElement) {
  searchElement.remove();
  const mainRow = document.getElementById("mainRow");
  if (mainRow) {
    const p = document.createElement("p");
    p.className = "card-description mt-3 ml-2 px-2 py-1 rounded text-muted border";
    p.innerHTML = `No vehicles found for this <code>filter</code> (<code><%= filterCondition %></code>).`;

    // Insert it as the first child
    mainRow.insertBefore(p, mainRow.firstChild);
  }


}
}




        }
      
    
        

        
      })
      .catch((error) => {

        if (
                error.message.includes("Unexpected token '<'") ||
                error.message.includes("position 0") // Firefox/Edge sometimes
              ) {
                window.location.href = "/coreLogin";
                return;
              }
        document.getElementById("loader").style.display = "none";
         alert(error.message)
      });
    }
  } else {
    alert("Invalid status value");
  }
}


window.onload = function () {
        document.getElementById("loader").style.display = "none";
      };
      


 </script>
  
    

