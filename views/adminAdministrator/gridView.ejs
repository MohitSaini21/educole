<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <title>gridView</title>
    <!-- plugins:css -->
    <link
      rel="stylesheet"
      href="/assets/vendors/mdi/css/materialdesignicons.min.css"
    />
    <link rel="stylesheet" href="/assets/vendors/css/vendor.bundle.base.css" />
    <!-- endinject -->
    <!-- Plugin css for this page -->

    <!-- End plugin css for this page -->
    <!-- inject:css -->
    <!-- endinject -->
    <!-- Layout styles -->
    <link rel="stylesheet" href="/assets/css/style.css" />
    <!-- End layout styles -->

    
  </head>
  <body>
    <div class="container-scroller">
      <!-- partial:partials/_sidebar.html -->
      <%- include('../corePartials/sidebar.ejs') %>
      <!-- partial -->
      <div class="container-fluid page-body-wrapper">
        <!-- partial:partials/_navbar.html -->
        <%- include('../corePartials/nav.ejs') %>
        <!-- partial -->
        <div class="main-panel">
          <div class="content-wrapper">
            <div class="page-header">
              <h3 class="page-title">Grid View</h3>
              <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                  <li class="breadcrumb-item">
                    <a href="/admin/mapView">Live Map View</a>
                  </li>
                  <li class="breadcrumb-item active" aria-current="page">
                    Grid View
                  </li>
                </ol>
              </nav>
            </div>
            <div class="container-fluid px-0">
              <div class="row no-gutters" id="grid"></div>
            </div>
          </div>
          <!-- content-wrapper ends -->
        </div>
        <!-- main-panel ends -->
      </div>
      <!-- page-body-wrapper ends -->
    </div>

    <%- include('../corePartials/loader.ejs') %>
    <!-- container-scroller -->
    <!-- plugins:js -->
    <script src="/assets/vendors/js/vendor.bundle.base.js"></script>
    <!-- endinject -->
    <!-- Plugin js for this page -->

    <!-- End plugin js for this page -->
    <!-- inject:js -->
    <script src="/assets/js/off-canvas.js"></script>
    <script src="/assets/js/hoverable-collapse.js"></script>
    <script src="/assets/js/misc.js"></script>
    <script src="/assets/js/settings.js"></script>
    <script src="/assets/js/todolist.js"></script>
    <!-- endinject -->
    <!-- Custom js for this page -->
    <script src="/assets/js/dashboard.js"></script>

    <script src="/socket.io/socket.io.js"></script>

    <!-- End custom js for this page -->

    <!-- custom Scripts -->

    <script>
                                  window.onload = function () {
                                    document.getElementById("loader").style.display = "none";
                                  };



                                       const user= <%- JSON.stringify(user) %>;
                            const socket = io({
                              query: {
                                adminId: user._id
                              },
                              reconnection: true,             // Enable automatic reconnection
      reconnectionAttempts: Infinity, // Try forever
      reconnectionDelay: 5000,        // Wait 5 seconds before retrying
      reconnectionDelayMax: 10000,    // Max delay between attempts
      timeout: 20000,
                            });



                        setInterval(() => {
        socket.emit("💓"); // can be any light event like "ping" or "💓"
      }, 2000); // Every 5 seconds (you can try 10000 = 10 sec if stable)


                            socket.emit("liveBuses", function (response) {
                        if (response.success) {
                          console.log(response);

                          const busIds = response.data; // assuming it's an array of bus IDs
                          const gridContainer = document.getElementById("grid");

                          // Clear existing grid content (optional)
                          gridContainer.innerHTML = "";

                          busIds.forEach((busId) => {
                            const colDiv = document.createElement("div");
                            colDiv.className = "col-12 col-sm-6 col-md-4 col-lg-3 p-0 m-0";
                            colDiv.id = `${busId}`; // ✅ Assign unique ID

                            colDiv.innerHTML = `
                              <iframe
                                src="/locationBus/${busId}"
                                style="height: 300px; width: 100%; border: 1px solid rgba(0, 0, 0, 0.2); display: block; pointer-events: none;"
                              </iframe>
                            `;

                                 colDiv.addEventListener("click", () => {
              window.location.href = `/admin/particularBusLive/${busId}`;
            });

                            gridContainer.appendChild(colDiv);
                          });

                        } else {


                          console.log("Data does not exist");
                        }
                      });

                      const gridContainer = document.getElementById("grid");

              // 👉 ADD Event: Add new iframe block for a bus
          socket.on("add", (busId) => {
            const existing = document.getElementById(`${busId}`);
            if (existing) return; // Avoid duplicates

            const colDiv = document.createElement("div");
            colDiv.className = "col-12 col-sm-6 col-md-4 col-lg-3 p-0 m-0";

            colDiv.id = `${busId}`; // updated to avoid duplicate check issues

            colDiv.innerHTML = `


              <iframe
                src="/locationBus/${busId}"
            style="height: 300px; width: 100%; border: 1px solid rgba(0, 0, 0, 0.2); display: block; pointer-events: none;"

              </iframe>
            `;

            // ✅ Add click event to redirect to live page
            colDiv.addEventListener("click", () => {
              window.location.href = `/admin/particularBusLive/${busId}`;
            });



            gridContainer.appendChild(colDiv);
            console.log(`✅ Bus added: ${busId}`);
          });



                socket.on("remove", (busId) => {
                  const busDiv =document.getElementById(busId);

                  if (busDiv) {


                    busDiv.remove();
                    console.log(`❌ Bus removed: ${busId}`);
                  } else {
                    console.log(`⚠️ Bus not found in DOM: ${busId}`);
                  }
                });
    </script>
    <script type="module" src="/foreground.js"></script>
    <!-- custom Scripts -->
  </body>
</html>
