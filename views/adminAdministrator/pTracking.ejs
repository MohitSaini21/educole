<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <title>waliaglobalacademy</title>
    <!-- plugins:css -->
    <link
      rel="stylesheet"
      href="/assets/vendors/mdi/css/materialdesignicons.min.css"
    />
    <link rel="stylesheet" href="/assets/loader.css" />
    <link rel="stylesheet" href="/assets/vendors/css/vendor.bundle.base.css" />



    
    <!-- endinject -->
    <!-- Plugin css for this page -->
  
    
    <!-- You can add this inside your page CSS or <style> -->
    <style>
      .row-updated {
        animation: blinkRow 0.3s ease-in-out 2;
        background-color: #fff8dc !important; /* Light yellow highlight */
      }

      @keyframes blinkRow {
        0% {
          background-color: #fff8dc;
        }
        50% {
          background-color: #fff4b2;
        }
        100% {
          background-color: #fff8dc;
        }
      }
    </style>

    <!-- End plugin css for this page -->
    <!-- inject:css -->
    <!-- endinject -->
    <!-- Layout styles -->
    <link rel="stylesheet" href="/assets/css/style.css" />
    <!-- End layout styles -->
    <link rel="shortcut icon" href="/assets/images/favicon.png" />
  </head>
  <body>
    <div class="container-scroller">
      <!-- partial:partials/_sidebar.html -->

      <%- include('../corePartials/sidebar.ejs') %>
      <!-- partial -->
      <div class="container-fluid page-body-wrapper">
        <!-- partial:partials/_navbar.html -->

        <%- include('../corePartials/nav.ejs') %>
        <!-- partial -->
        <div class="main-panel">
          <div class="content-wrapper">
            <h3 class="h4 border-bottom pb-2 mb-3">
              Bus No:
              <span class="text-white"
                ><a href="/admin/CDB/<%=bus._id  %>"
                  ><%=bus.busNumber %></a
                ></span
              >
            </h3>

            <p class="mb-2">
              <strong>Driver:</strong> <%=bus.driver.name %>
              <span class="text-muted">(<%=bus.driver.phone %>)</span>
            </p>

            <p class="mb-0">
              <strong>Conductor:</strong> <%=bus.conductor.name %>
              <span class="text-muted">(<%=bus.conductor.phone %>)</span>
            </p>

            <br />

            <div class="row m-0 p-0">
              <div class="col-12 m-0 p-0">
                <div class="card m-0 p-1">
                  <div class="card-body m-0 p-1">
                    <div class="row">
                      <div class="col-md-5">
                        <iframe
                          src="/locationBus/<%=bus._id  %>"
                          style="
                            height: 300px;
                            width: 100%;
                            border: none;
                            display: block;
                          "
                        ></iframe>
                      </div>
                      <div class="col-md-7">
                        <% if (user.role === "administrator") { %>
                        <iframe
                          src="/administrator/settings/liveStream/<%=bus._id  %>"
                          style="
                            height: 300px;
                            width: 100%;
                            border: none;
                            display: block;
                          "
                        ></iframe>
                        <% } else { %>
                        <div
                          class="d-flex justify-content-center align-items-center"
                          style="height: 300px"
                        >
                          <p class="text-muted h5 mb-0">
                            You Can not Enjoy live Camera View Vehchiles
                          </p>
                        </div>
                        <% } %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <br />
            <div class="row">
              <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                  <div class="card-body">
                    <h4 class="card-title">Stops Covered</h4>

                    <div class="table-responsive">
                      <table class="table table-bordered text-center" id="stops-covered">
                        <thead class="thead-dark">
                          <tr>
                            <th>#</th>
                            <th>Stop Name</th>
                            <th>Morning</th>
                            <th>Evening</th>
                          </tr>
                        </thead>
                        <tbody>
                          
                          <% if (busLog && busLog.stops && busLog.stops.length > 0) { %>
                            <% busLog.stops.forEach((stopLog, index) => { %>
                              <tr id="<%= stopLog.stop._id %>">
                                <td><%= index + 1 %></td>
                                <td><%= stopLog.stopName || '__' %></td>
                      
                                <!-- Morning Times -->
                                <td>
                                  <div><strong>Expected:</strong> <%= stopLog.eMorningTime ? stopLog.eMorningTime : "__" %></div>

                                  <div>
                                    <div>

                                 
                                      
                                    <strong>Actual:</strong> <%= stopLog.morningTime || '__' %></div>
                                </td>
                      
                                <!-- Evening Times -->
                                <td>
                                  <div><strong>Expected:</strong> <%= stopLog.eEveningTime ? stopLog.eEveningTime: "__" %></div>
                                  <div><strong>Actual:</strong> <%= stopLog.eveningTime || '__' %></div>
                                </td>
                              </tr>
                            <% }) %>
                            <% } else { %>
                              <tr>
                                <td colspan="4">No events recorded</td>
                              </tr>
                              <% } %>
                        </tbody>
                      </table>
                      
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                  <div class="card-body">
                    <h4 class="card-title">Campus Events</h4>

                    <div class="table-responsive mt-4">
              
                      
                      <table class="table table-bordered text-center">
                        <thead class="thead-dark">
                          <tr>
                            <th>#</th>
                            <th>campus</th>
                            <th>Event Type</th>
                            <th>Timestamp</th>
                          </tr>
                        </thead>
                        <tbody id="event-timeline-body">
                          <% if (busLog && busLog.events && busLog.events.length
                          > 0) { %> <% busLog.events.forEach((ev, index) => { %>
                          <tr>
                            <td><%= index + 1 %></td>
                                 <td><%=ev.campus %></td>
                            <td>
                              <span
                                class="badge <%= ev.event === 'Entered' ? 'bg-success' : 'bg-danger' %>"
                              >
                                <%= ev.event %>
                              </span>
                            </td>
                            <td>
                              <%=ev.timestamp%>
                            </td>
                       
                          </tr>
                          <% }) %> <% } else { %>
                          <tr>
                            <td colspan="4">No events recorded</td>
                          </tr>
                          <% } %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <br />
          </div>
          <!-- content-wrapper ends -->
          <!-- partial:partials/_footer.html -->
          <%- include('../corePartials/loader.ejs') %> <%-
          include('../corePartials/footer.ejs') %>

          <!-- partial -->
        </div>
        <!-- main-panel ends -->
      </div>
      <!-- page-body-wrapper ends -->
    </div>
    <!-- container-scroller -->
    <!-- plugins:js -->
    <script src="/assets/vendors/js/vendor.bundle.base.js"></script>
    <!-- endinject -->
    <!-- Plugin js for this page -->
 
    
