      function updateEventTimelineTable(events) {
    const tbody = document.getElementById("event-timeline-body");
    if (!tbody) {
      console.error("❌ Cannot find tbody with ID 'event-timeline-body'");
      return;
    }

    // Clear old rows
    tbody.innerHTML = "";

    if (!Array.isArray(events) || events.length === 0) {
      const emptyRow = document.createElement("tr");
      emptyRow.innerHTML = `<td colspan="4">No events recorded</td>`;
      tbody.appendChild(emptyRow);
      return;
    }

    // Append new rows
    events.forEach((ev, index) => {
      const row = document.createElement("tr");

      // Set status color
      const badgeClass =
        ev.eventTypet === "Entered" ? "bg-success" : ev.eventType === "Exited" ? "bg-danger" : "bg-secondary";

      row.innerHTML = `
        <td>${index + 1}</td>
        <td>${ev.campus || "Unknown"}</td>
        <td><span class="badge ${badgeClass}">${ev.eventType}</span></td>
        <td>${ev.time || "--"}</td>
      `;
      tbody.appendChild(row);
    });
  }

      window.onload = function () {
        document.getElementById("loader").style.display = "none";
      };
