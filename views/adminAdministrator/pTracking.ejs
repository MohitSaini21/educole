      // fucntiom to update the row

  function updateStopsCoveredTable(reachedStops) {
  const tbody = document.querySelector("#stops-covered tbody");
  if (!tbody) {
    console.error("❌ tbody not found inside #stops-covered");
    return;
  }
   // Clear old rows
    tbody.innerHTML = "";
  console.log("✅ Received reachedStops:", reachedStops);

  Object.entries(reachedStops).forEach(([stopId, info], index) => {
    const rowId = String(stopId);
    const existingRow = document.getElementById(rowId);

    const stopName = info.stopName || "Unknown";
    const eMorningTime = info.eMorningTime || "__";
    const morningTime = info.morningTime || "__";
    const eEveningTime = info.eEveningTime || "__";
    const eveningTime = info.eveningTime || "__";

    // Create new row element
    const newRow = document.createElement("tr");
    newRow.id = rowId;

    // Set row HTML
    newRow.innerHTML = `
      <td></td>
      <td>${stopName}</td>
      <td>
        <div><strong>Expected:</strong> ${eMorningTime}</div>
        <div><strong>Actual:</strong> ${morningTime}</div>
      </td>
      <td>
        <div><strong>Expected:</strong> ${eEveningTime}</div>
        <div><strong>Actual:</strong> ${eveningTime}</div>
      </td>
    `;

    // Replace if exists, or append new
    if (existingRow) {
      tbody.replaceChild(newRow, existingRow);
    } else {
      tbody.appendChild(newRow);
    }

    // Blink effect on update
    newRow.classList.add("row-updated");
    setTimeout(() => {
      newRow.classList.remove("row-updated");
    }, 3000);
  });

  // Renumber rows
  Array.from(tbody.querySelectorAll("tr")).forEach((row, i) => {
    const indexCell = row.querySelector("td:first-child");
    if (indexCell) indexCell.textContent = i + 1;
  });
}

