<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <title>Educole</title>
    <!-- plugins:css -->
    <link
      rel="stylesheet"
      href="/assets/vendors/mdi/css/materialdesignicons.min.css"
    />
    <link rel="stylesheet" href="/assets/vendors/css/vendor.bundle.base.css" />

    <!-- endinject -->
    <!-- Plugin css for this page -->
    <!-- End Plugin css for this page -->
    <!-- inject:css -->
    <!-- endinject -->
    <!-- Layout styles -->
    <link rel="stylesheet" href="/assets/css/style.css" />
    <!-- <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" /> -->
    <!-- End layout styles -->

    

    <style>
      .preview {
        width: 150px; /* Set a fixed width */
        height: 150px; /* Set a fixed height */
        object-fit: cover; /* Ensures the image covers the container without distortion */
        border-radius: 50%; /* Keeps the image rounded */
      }
      @media (max-width: 576px) {
        .img-container-responsive {
          height: 200px !important;
        }
      }
    </style>

    <link
      rel="stylesheet"
      href="/assets/vendors/owl-carousel-2/owl.carousel.min.css"
    />
    <link
      rel="stylesheet"
      href="/assets/vendors/owl-carousel-2/owl.theme.default.min.css"
    />
    <!-- Owl Carousel CSS -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css"
    />

    <link rel="stylesheet" href="/assets/loader.css" />
  </head>
  <body>
    <div class="container-scroller">
      <!-- partial:../.../corePartials/_sidebar.html -->

      <%- include('../corePartials/sidebar.ejs') %>
      <!-- partial -->
      <div class="container-fluid page-body-wrapper">
        <!-- partial:../.../corePartials/_navbar.html -->

        <%- include('../corePartials/nav.ejs') %>
        <!-- part x`ial -->
        <div class="main-panel">
          <div class="content-wrapper">
            <div class="row">
              <div class="col-md-6 grid-margin stretch-card">
                <div class="card">
                  <div class="card-body">
                    <h4 class="card-title">Driver Information</h4>

                    <div class="container d-flex justify-content-end">
                      <img
                        src="<%=bus.driver.profilePhoto  %>"
                        id="Preview"
                        class="img-thumbnail rounded-circle preview"
                        alt="..."
                      />
                    </div>
                    <br />
                    <ol>
                      <% Object.entries(bus.driver).forEach(([key, value]) => {
                      %> <% if (['_id', 'profilePhoto',
                      'assignedBus',"__v"].includes(key)) return; %> <% if (key
                      === 'password') { %>
                      <li><strong>Password:</strong> *****</li>

                      <% } else if (key === 'driverDocuments' &&
                      Array.isArray(value)) { %>
                      <li>
                        <strong>Driver Documents: </strong>
                        <ul>
                          <% value.forEach(doc => { %>
                          <li>
                            📎 <strong><%= doc.name %>:</strong>
                            <a href="<%= doc.url %>" target="_blank">View</a>
                          </li>
                          <% }) %>
                        </ul>
                      </li>

                      <% } else { %>
                      <li>
                        <strong
                          ><%= key.charAt(0).toUpperCase() + key.slice(1) %>:
                        </strong>
                        <small><%= value %> </small>
                      </li>
                      <% } %> <% }) %>
                    </ol>
                    <% if (user.role=="administrator") { %>
                    <button type="button" class="btn btn-link btn-fw">
                      <a
                        href="/administrator/settings/conductorDriver?driverId=<%=bus.driver._id  %>"
                        >update</a
                      >
                    </button>
                    <% } %>
                  </div>
                </div>
              </div>

              <div class="col-md-6 grid-margin stretch-card">
                <div class="card">
                  <div class="card-body">
                    <h4 class="card-title">Conductor Information</h4>

                    <div class="container d-flex justify-content-end">
                      <img
                        src="<%=bus.conductor.profilePhoto  %>"
                        id="Preview"
                        class="img-thumbnail rounded-circle preview"
                        alt="..."
                      />
                    </div>
                    <br />
                    <ol>
                      <% Object.entries(bus.conductor).forEach(([key, value]) =>
                      { %> <% if (['_id', 'profilePhoto',
                      'assignedBus',"__v"].includes(key)) return; %> <% if (key
                      === 'password') { %>
                      <li><strong>Password:</strong> *****</li>

                      <% } else if (key === 'driverDocuments' &&
                      Array.isArray(value)) { %>
                      <li>
                        <strong>Driver Documents: </strong>
                        <ul>
                          <% value.forEach(doc => { %>
                          <li>
                            📎 <strong><%= doc.name %>:</strong>
                            <a href="<%= doc.url %>" target="_blank">View</a>
                          </li>
                          <% }) %>
                        </ul>
                      </li>

                      <% } else { %>
                      <li>
                        <strong
                          ><%= key.charAt(0).toUpperCase() + key.slice(1) %>:
                        </strong>
                        <small><%= value %> </small>
                      </li>
                      <% } %> <% }) %>
                    </ol>
                    <% if (user.role=="administrator") { %>
                    <button type="button" class="btn btn-link btn-fw">
                      <a
                        href="/administrator/settings/conductorDriver?conductorId=<%=bus.conductor._id  %>"
                        >update</a
                      >
                    </button>
                    <% } %>
                  </div>
                </div>
              </div>

              <div class="col-md-12 grid-margin stretch-card">
                <div class="card">
                  <div class="card-body">
                    <h4 class="card-title">Bus Photos</h4>
                    <div
                      class="owl-carousel owl-theme full-width owl-carousel-dash portfolio-carousel"
                      id="owl-carousel-basic"
                    >
                      <% if (bus.busImages && bus.busImages.length > 0) { %> <%
                      bus.busImages.forEach(img => { %>
                      <div class="item">
                        <div
                          class="position-relative overflow-hidden bg-light rounded img-container-responsive"
                          style="height: 400px"
                        >
                          <img
                            src="<%= img %>"
                            alt="Bus Image"
                            class="position-absolute top-50 start-50 translate-middle w-100 h-auto object-fit-contain"
                            style="max-height: 100%"
                          />
                        </div>
                      </div>
                      <% }) %> <% } else { %>
                      <p class="text-muted">No bus images available.</p>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>

              <div class="container mt-4">
                <div class="card shadow-sm">
                  <div class="card-body">
                    <h4 class="card-title mb-4">🚌 Bus Details</h4>

                    <div class="container d-flex justify-content-end">
                      <img
                        src="<%=bus.iconPhoto  %>"
                        id="Preview"
                        class="img-thumbnail rounded-circle preview"
                        alt="..."
                      />
                    </div>

                    <!-- Bus Key-Value Info -->
                    <div class="row">
                      <% Object.entries(bus).forEach(([key, value]) => { %> <%
                      if (['_id', '__v', 'iconPhoto', 'driver', 'conductor',
                      'routeStops', 'busDocuments', 'busImages'].includes(key))
                      return; %>

                      <div class="col-md-4 mb-3">
                        <div>
                          <span class="text-muted fw-medium"
                            ><%= key.charAt(0).toUpperCase() + key.slice(1)
                            %>:</span
                          >
                          <div class="fw-semibold">
                            <% if (key === 'lastServiced' || key ===
                            'updatedAt') { %> <%= new
                            Date(value).toLocaleString() %> <% } else if (key
                            === 'live') { %> <%= value ? 'Yes' : 'No' %> <% }
                            else { %> <%= value %> <% } %>
                          </div>
                        </div>
                      </div>
                      <% }) %>
                    </div>

                    <!-- Route Stops Table -->
                    <h5 class="mt-5 mb-2">📍 Route Stops</h5>
                    <div class="table-responsive">
                      <table class="table table-bordered table-striped">
                        <thead class="table-light">
                          <tr>
                            <th>Stop Name</th>
                            <th>Morning Time</th>
                            <th>Evening Time</th>
                            <th>Latitude</th>
                            <th>Longitude</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% bus.routeStops.forEach(stop => { %>
                          <tr>
                            <td><%= stop.stopName %></td>
                            <td><%= stop.morningTime %></td>
                            <td><%= stop.eveningTime %></td>
                            <td><%= stop.latitude %></td>
                            <td><%= stop.longitude %></td>
                          </tr>
                          <% }); %>
                        </tbody>
                      </table>

                      <br />

                      <% if (user.role=="administrator") { %>

                      <button
                        type="button"
                        class="btn btn-inverse-success btn-fw"
                      >
                        <a
                          href="/administrator/settings/busEntire/<%=bus._id  %>"
                          >update</a
                        >
                      </button>

                      <br />
                      <br />
                      <button
                        type="button"
                        class="btn btn-inverse-danger btn-fw"
                        onclick="Delete()"
                      >
                        Delete Bus
                      </button>
                      <% } %>

                      <br />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- content-wrapper ends -->
          <!-- partial:../.../corePartials/_footer.html -->
          <%- include('../corePartials/footer.ejs') %>
          <%-include('../corePartials/loader.ejs') %>
          <!-- partial -->
        </div>
        <!-- main-panel ends -->
      </div>
      <!-- page-body-wrapper ends -->
    </div>

    <!-- ✅ Delete Confirmation Modal -->
    <div
      class="modal fade"
      id="deleteModal"
      tabindex="-1"
      aria-labelledby="deleteModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="deleteModalLabel">Confirm Deletion</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>

          <div class="modal-body">
            <form id="deleteForm">
              <div class="mb-3">
                <label for="deletePassword" class="form-label"
                  >Enter Password to Confirm:</label
                >
                <input
                  type="password"
                  class="form-control"
                  id="deletePassword"
                  placeholder="Your password"
                  required
                />
              </div>
            </form>
          </div>

          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-secondary"
              data-bs-dismiss="modal"
            >
              Cancel
            </button>
            <button type="submit" form="deleteForm" class="btn btn-danger">
              Delete
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- container-scroller -->
    <!-- plugins:js -->
    <script src="/assets/vendors/js/vendor.bundle.base.js"></script>
    <!-- endinject -->
    <!-- Plugin js for this page -->
    <!-- End plugin js for this page -->
    <!-- inject:js -->
    <script src="/assets/js/off-canvas.js"></script>
    <script src="/assets/js/hoverable-collapse.js"></script>
    <script src="/assets/js/misc.js"></script>
    <script src="/assets/js/settings.js"></script>
    <script src="/assets/js/todolist.js"></script>
    <script src="/assets/vendors/owl-carousel-2/owl.carousel.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Owl Carousel JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
                  const bus = <%- JSON.stringify(bus) %>;
      $(document).ready(function () {
        $("#owl-carousel-basic").owlCarousel({
          items: 1, // Show 1 image at a time
          loop: true, // Infinite loop
          margin: 10,
          nav: true, // Show next/prev buttons

          autoplay: true,
          autoplayTimeout: 3000,
        });
      });
    </script>
    <script>
      const busId = bus._id;

      function Delete() {
        const modal = new bootstrap.Modal(
          document.getElementById("deleteModal")
        );
        modal.show();
      }

      document
        .getElementById("deleteForm")
        .addEventListener("submit", function (e) {
          e.preventDefault();

          const password = document.getElementById("deletePassword").value;

          // Send POST request
          document.getElementById("loader").style.display = "flex";
          fetch("/administrator/settings/delete-bus", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ busId, password }),
          })
            .then((response) => response.json())
            .then((data) => {
              document.getElementById("loader").style.display = "none";
              alert(data.message); // Show server's message (success or error)
              if (data.success) {
                setInterval(() => {
                  window.location.href = "/admin/garrage";
                }, 1000);
              }
            })
            .catch((error) => {
              document.getElementById("loader").style.display = "none";
              alert("An error occurred: " + error.message);
            });
        });

      // 3. Hide loader once window is loaded
      window.onload = function () {
        document.getElementById("loader").style.display = "none";
      };
    </script>
        <script type="module" src="/foreground.js"></script>

    <!-- endinject -->
    <!-- Custom js for this page -->
    <!-- End custom js for this page -->
  </body>
</html>
