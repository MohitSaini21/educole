<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <title>Corona Admin</title>
    <!-- plugins:css -->
    <link
      rel="stylesheet"
      href="/assets/vendors/mdi/css/materialdesignicons.min.css"
    />
    <link rel="stylesheet" href="/assets/vendors/css/vendor.bundle.base.css" />
    <!-- endinject -->
    <!-- Plugin css for this page -->

    <!-- End plugin css for this page -->
    <!-- inject:css -->
    <!-- endinject -->
    <!-- Layout styles -->
    <link rel="stylesheet" href="/assets/css/style.css" />

    <link rel="stylesheet" href="/assets/loader.css" />
    <!-- End layout styles -->
    <link rel="shortcut icon" href="/assets/images/favicon.png" />

    <style>
      .custom-modal {
        display: none;
        position: fixed;
        z-index: 1050;
        padding-top: 60px;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.9);
      }

      .custom-modal-content {
        margin: auto;
        display: block;
        max-width: 90%;
        max-height: 80vh;
        border: 4px solid white;
        border-radius: 8px;
      }

      .custom-close {
        position: absolute;
        top: 20px;
        right: 35px;
        color: #fff;
        font-size: 40px;
        font-weight: bold;
        cursor: pointer;
      }

      @media (max-width: 600px) {
        .custom-modal-content {
          width: 95%;
        }
      }
    </style>
  </head>
  <body>
    <div class="container-scroller">
      <!-- partial:partials/_sidebar.html -->

      <%- include('../corePartials/sidebar.ejs') %>
      <!-- partial -->
      <div class="container-fluid page-body-wrapper">
        <!-- partial:partials/_navbar.html -->

        <%- include('../corePartials/nav.ejs') %>
        <!-- partial -->
        <div class="main-panel">
          <div class="content-wrapper">
            <div class="row">
              <div class="col-12 grid-margin stretch-card" id="searchBus">
                <div class="card">
                  <div class="card-body">
                    <h4 class="card-title">
                      🚌 Historical Records for Bus Number <%= bus.busNumber %>
                    </h4>

                    <form class="form-inline" id="vehicleSearchForm">
                      <div class="form-group mr-3">
                        <input
                          type="date"
                          class="form-control"
                          id="searchDate"
                          required
                        />
                      </div>

                      <button type="submit" class="btn btn-primary">
                        🔍 Search
                      </button>
                    </form>
                  </div>
                </div>
              </div>

              <% if (busLog) { %>

              <div class="container">
                <h6>
                  <p>
                    Bus Record for <%= bus.busNumber %> on <%=
                    moment(busLog.logDate, "YYYY-MM-DD").format("DD-MM-YYYY") %>
                  </p>
                </h6>
                <br />
                <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
                  <li class="nav-item" role="presentation">
                    <button
                      class="nav-link active"
                      id="pills-home-tab"
                      data-bs-toggle="pill"
                      data-bs-target="#pills-home"
                      type="button"
                      role="tab"
                      aria-controls="pills-home"
                      aria-selected="true"
                    >
                      Routes
                    </button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button
                      class="nav-link"
                      id="pills-profile-tab"
                      data-bs-toggle="pill"
                      data-bs-target="#pills-profile"
                      type="button"
                      role="tab"
                      aria-controls="pills-profile"
                      aria-selected="false"
                    >
                      Events
                    </button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button
                      class="nav-link"
                      id="pills-contact-tab"
                      data-bs-toggle="pill"
                      data-bs-target="#pills-contact"
                      type="button"
                      role="tab"
                      aria-controls="pills-contact"
                      aria-selected="false"
                    >
                      Meter
                    </button>
                  </li>
                </ul>
                <div class="tab-content" id="pills-tabContent">
                  <div
                    class="tab-pane fade show active"
                    id="pills-home"
                    role="tabpanel"
                    aria-labelledby="pills-home-tab"
                    tabindex="0"
                  >
                    <!-- // A about routes   -->

                    <div class="row">
                      <div
                        class="col-md-6 grid-margin stretch-card"
                        id="videoTag"
                      >
                        <div class="card">
                          <div class="card-body p-0">
                            <iframe
                              id="videoIframe"
                              src="/routingMachine?busId=<%=bus._id  %>"
                              frameborder="0"
                              style="width: 100%; height: 300px"
                              allow="autoplay; fullscreen"
                            ></iframe>
                          </div>
                        </div>
                      </div>

                      <div
                        class="col-md-6 grid-margin stretch-card"
                        id="videoTag"
                      >
                        <div class="card">
                          <div class="card-body p-0">
                            <!-- Remove padding for full container usage -->
                            <iframe
                              id="videoIframe"
                              src="/admin/routingMachine?logId=<%=busLog._id  %>"
                              frameborder="0"
                              style="width: 100%; height: 300px"
                              allow="autoplay; fullscreen"
                            ></iframe>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div
                    class="tab-pane fade"
                    id="pills-profile"
                    role="tabpanel"
                    aria-labelledby="pills-profile-tab"
                    tabindex="0"
                  >
                    <!-- // events -->
                    <div class="row">
                      <div class="col-lg-12 grid-margin stretch-card">
                        <div class="card">
                          <div class="card-body">
                            <h4 class="card-title">Stops Covered</h4>

                            <div class="table-responsive">
                              <table
                                class="table table-bordered text-center"
                                id="stops-covered"
                              >
                                <thead class="thead-dark">
                                  <tr>
                                    <th>#</th>
                                    <th>Stop Name</th>
                                    <th>Morning</th>
                                    <th>Evening</th>
                                  </tr>
                                </thead>
                                <tbody>
                                  <% if (busLog && busLog.stops &&
                                  busLog.stops.length > 0) { %> <%
                                  busLog.stops.forEach((stopLog, index) => { %>
                                  <tr
                                    id="stop-<%= stopLog.stop._id || stopLog.stop %>"
                                  >
                                    <td><%= index + 1 %></td>
                                    <td><%= stopLog.stopName || '__' %></td>

                                    <!-- Morning Times -->
                                    <td>
                                      <div>
                                        <strong>Expected:</strong> <%=
                                        stopLog.eMorningTime ?
                                        stopLog.eMorningTime : "__" %>
                                      </div>
                                      <div>
                                        <strong>Actual:</strong> <%=
                                        stopLog.morningTime || '__' %>
                                      </div>
                                    </td>

                                    <!-- Evening Times -->
                                    <td>
                                      <div>
                                        <strong>Expected:</strong> <%=
                                        stopLog.eEveningTime ?
                                        stopLog.eEveningTime : "__" %>
                                      </div>
                                      <div>
                                        <strong>Actual:</strong> <%=
                                        stopLog.eveningTime || '__' %>
                                      </div>
                                    </td>
                                  </tr>
                                  <% }) %> <% } else { %>
                                  <tr>
                                    <td colspan="6">No stops found</td>
                                  </tr>
                                  <% } %>
                                </tbody>
                              </table>
                            </div>
                          </div>
                        </div>
                      </div>
                      <div class="col-lg-12 grid-margin stretch-card">
                        <div class="card">
                          <div class="card-body">
                            <h4 class="card-title">Campus Events</h4>

                            <div class="table-responsive mt-4">
                              <table class="table table-bordered text-center">
                                <thead class="thead-dark">
                                  <tr>
                                    <th>#</th>
                                    <th>campus</th>
                                    <th>Event Type</th>
                                    <th>Timestamp</th>
                                  </tr>
                                </thead>
                                <tbody>
                                  <% if (busLog && busLog.events &&
                                  busLog.events.length > 0) { %> <%
                                  busLog.events.forEach((ev, index) => { %>
                                  <tr>
                                    <td><%= index + 1 %></td>
                                    <td><%=ev.campus %></td>
                                    <td>
                                      <span
                                        class="badge <%= ev.event === 'Entered' ? 'bg-success' : 'bg-danger' %>"
                                      >
                                        <%= ev.event %>
                                      </span>
                                    </td>
                                    <td><%= ev.timestamp%></td>
                                  </tr>
                                  <% }) %> <% } else { %>
                                  <tr>
                                    <td colspan="4">No events recorded</td>
                                  </tr>
                                  <% } %>
                                </tbody>
                              </table>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div
                    class="tab-pane fade"
                    id="pills-contact"
                    role="tabpanel"
                    aria-labelledby="pills-contact-tab"
                    tabindex="0"
                  >
                    <!-- // Meter -->

                    <!-- Include Bootstrap modal once -->
                    <div id="customImageModal" class="custom-modal">
                      <span class="custom-close" onclick="closeCustomModal()"
                        >&times;</span
                      >
                      <img class="custom-modal-content" id="customModalImage" />
                    </div>

                    <div class="row">
                      <div class="col-12">
                        <div class="card">
                          <div class="card-body">
                            <h4 class="card-title">Meter Snaps</h4>
                            <div class="row g-3">
                              <!-- Morning Snap -->
                              <div class="col-md-6">
                                <div
                                  class="card shadow-sm border border-primary h-100"
                                >
                                  <div class="card-body">
                                    <h5 class="card-title text-primary mb-3">
                                      🌅 Morning Snapshot
                                    </h5>

                                    <% if (busLog?.morningSnap?.reading != null)
                                    { %>
                                    <p>
                                      <strong>Reading:</strong> <%=
                                      busLog.morningSnap.reading %> km
                                    </p>
                                    <p>
                                      <strong>Captured At:</strong>
                                      <%= busLog.morningSnap.takenAt %>
                                    </p>
                                    <% if (busLog.morningSnap.image) { %>
                                    <button
                                      class="btn btn-sm btn-outline-info"
                                      onclick='previewImage("<%= busLog.morningSnap.image.replace(/\\/g, "/") %>")'
                                    >
                                      🔍 Preview Meter
                                    </button>
                                    <% } %> <% } else { %>
                                    <p class="text-danger mb-0">
                                      Operator did not provide the morning
                                      reading.
                                    </p>
                                    <% } %>
                                  </div>
                                </div>
                              </div>

                              <!-- Evening Snap -->
                              <div class="col-md-6">
                                <div
                                  class="card shadow-sm border border-secondary h-100"
                                >
                                  <div class="card-body">
                                    <h5 class="card-title text-primary mb-3">
                                      🌇 Evening Snapshot
                                    </h5>

                                    <% if (busLog?.eveningSnap?.reading != null)
                                    { %>
                                    <p>
                                      <strong>Reading:</strong> <%=
                                      busLog.eveningSnap.reading %> km
                                    </p>
                                    <p>
                                      <strong>Captured At:</strong>
                                      <%= busLog.eveningSnap.takenAt %>
                                    </p>
                                    <% if (busLog.eveningSnap.image) { %>
                                    <button
                                      class="btn btn-sm btn-outline-info"
                                      onclick='previewImage("<%= busLog.eveningSnap.image.replace(/\\/g, "/") %>")'
                                    >
                                      🔍 Preview Meter
                                    </button>
                                    <% } %> <% } else { %>
                                    <p class="text-danger mb-0">
                                      Operator did not provide the evening
                                      reading.
                                    </p>
                                    <% } %>
                                  </div>
                                </div>
                              </div>
                            </div>

                            <!-- /.row -->
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <% } else { %>

              <div class="container">
                <% if (requestedDate) { %>
                <p>
                  There is no available history for Bus <%= bus.busNumber %> on
                  <%= requestedDate %>.
                </p>
                <% } else { %>
                <p>
                  There is no available history for Bus <%= bus.busNumber %> in
                  the database.
                </p>
                <% } %>
              </div>
              <% } %>
            </div>
          </div>
          <!-- content-wrapper ends -->
          <!-- partial:partials/_footer.html -->
          <%- include('../corePartials/footer.ejs') %>
          <%-include('../corePartials/loader.ejs') %>
          <!-- partial -->
        </div>
        <!-- main-panel ends -->
      </div>
      <!-- page-body-wrapper ends -->
    </div>
    <!-- container-scroller -->
    <!-- plugins:js -->
    <script
      src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
      integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
      crossorigin="anonymous"
    ></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.min.js"
      integrity="sha384-RuyvpeZCxMJCqVUGFI0Do1mQrods/hhxYlcVfGPOfQtPJh0JCw12tUAZ/Mv10S7D"
      crossorigin="anonymous"
    ></script>
    <script>
      function previewImage(src) {
        const modal = document.getElementById("customImageModal");
        const modalImg = document.getElementById("customModalImage");

        modal.style.display = "block";
        modalImg.src = src;
      }

      function closeCustomModal() {
        const modal = document.getElementById("customImageModal");
        modal.style.display = "none";
      }

      // Optional: Close when clicked outside the image
      window.onclick = function (event) {
        const modal = document.getElementById("customImageModal");
        if (event.target === modal) {
          closeCustomModal();
        }
      };
    </script>

    <script src="/assets/vendors/js/vendor.bundle.base.js"></script>
    <!-- endinject -->
    <!-- Plugin js for this page -->

    <!-- End plugin js for this page -->
    <!-- inject:js -->
    <script src="/assets/js/off-canvas.js"></script>
    <script src="/assets/js/hoverable-collapse.js"></script>
    <script src="/assets/js/misc.js"></script>
    <script src="/assets/js/settings.js"></script>
    <script src="/assets/js/todolist.js"></script>
    <!-- endinject -->
    <!-- Custom js for this page -->
    <script src="/assets/js/dashboard.js"></script>
    <!-- End custom js for this page -->

    <script>
      const dateInput = document.getElementById("searchDate");

      const today = new Date();
      const tenDaysAgo = new Date();
      tenDaysAgo.setDate(today.getDate() - 10);

      // Format to YYYY-MM-DD
      const formatDate = (date) => date.toISOString().split("T")[0];

      dateInput.max = formatDate(today);
      dateInput.min = formatDate(tenDaysAgo);
    </script>

    <script>
         const bus= <%- JSON.stringify(bus) %>;
      document
        .getElementById("vehicleSearchForm")
        .addEventListener("submit", function (e) {
          e.preventDefault();

          const date = document.getElementById("searchDate").value;

          if (!date) {
            alert("Please enter  date.");
            return;
          }

          const encodedDate = encodeURIComponent(date);

          // Redirect with query parameters
          window.location.href = `/admin/particularHistory/${bus._id}?date=${encodedDate}`;
        });

        window.onload = function () {
        document.getElementById("loader").style.display = "none";
      };
    </script>
    <script type="module" src="/foreground.js"></script>
  </body>
</html>
