<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <title>inActiveVehicles</title>
    <!-- plugins:css -->
    <link
      rel="stylesheet"
      href="/assets/vendors/mdi/css/materialdesignicons.min.css"
    />
    <link rel="stylesheet" href="/assets/vendors/css/vendor.bundle.base.css" />
    <!-- endinject -->
    <!-- Plugin css for this page -->

    <link rel="stylesheet" href="/assets/loader.css" />

    <!-- End plugin css for this page -->
    <!-- inject:css -->
    <!-- endinject -->
    <!-- Layout styles -->
    <link rel="stylesheet" href="/assets/css/style.css" />
    <!-- End layout styles -->
    <link
      rel="icon"
      type="image/x-icon"
      href="https://waliaglobalacademy.in/wp-content/uploads/2024/06/cropped-walia-global-logo1.jpg"
    />
  </head>
  <body>
    <div class="container-scroller">
      <!-- partial:partials/_sidebar.html -->

      <%- include('../corePartials/sidebar.ejs') %>
      <!-- partial -->
      <div class="container-fluid page-body-wrapper">
        <!-- partial:partials/_navbar.html -->

        <%- include('../corePartials/nav.ejs') %>
        <!-- partial -->
        <div class="main-panel">
          <div class="content-wrapper">
            <h3>InActive Vehicles</h3>
            <br />
            <div class="row">
              <% buses.forEach(bus => { %>
              <div
                class="col-12 col-md-6 col-lg-4 grid-margin stretch-card bus-col"
                id="<%= bus._id %>"
                onclick="handleBusClick('<%= bus._id %>')"
                style="cursor: pointer; display: none"
              >
                <div class="card bg-dark text-white">
                  <div class="card-body">
                    <h4 class="card-title text-warning font-weight-bold mb-3">
                      🚌 <%= bus.busNumber %>
                    </h4>
                    <p class="mb-2">
                      <strong>📍 Route:</strong> <%= bus.route %>
                    </p>
                    <p class="mb-2">
                      <strong>👨‍✈️ Driver:</strong>
                      <%= bus.driver?.name || "N/A" %> <br />
                      <% if (bus.driver?.phone) { %>
                      <a
                        href="tel:<%= bus.driver.phone %>"
                        class="text-info"
                        style="text-decoration: none"
                      >
                        (<%= bus.driver.phone %>)
                      </a>
                      <% } else { %> N/A <% } %>
                    </p>
                    <p class="mb-0">
                      <strong>👨‍💼 Conductor:</strong>
                      <%= bus.conductor?.name || "N/A" %> <br />
                      <% if (bus.conductor?.phone) { %>
                      <a
                        href="tel:<%= bus.conductor.phone %>"
                        class="text-info"
                        style="text-decoration: none"
                      >
                        (<%= bus.conductor.phone %>)
                      </a>
                      <% } else { %> N/A <% } %>
                    </p>
                  </div>
                </div>
              </div>
              <% }) %>
            </div>
          </div>

          <!-- content-wrapper ends -->
          <!-- partial:partials/_footer.html -->
          <!-- <%- include('../corePartials/footer.ejs') %> --
         
        partial -->

          <%-include('../corePartials/loader.ejs') %>
          <!-- partial -->
        </div>
        <!-- main-panel ends -->
      </div>
      <!-- page-body-wrapper ends -->
    </div>
    <!-- container-scroller -->
    <!-- plugins:js -->
    <script src="/assets/vendors/js/vendor.bundle.base.js"></script>
    <!-- endinject -->
    <!-- Plugin js for this page -->

    <!-- End plugin js for this page -->
    <!-- inject:js -->
    <script src="/assets/js/off-canvas.js"></script>
    <script src="/assets/js/hoverable-collapse.js"></script>
    <script src="/assets/js/misc.js"></script>
    <script src="/assets/js/settings.js"></script>
    <script src="/assets/js/todolist.js"></script>
    <!-- endinject -->
    <!-- Custom js for this page -->
    <script src="/assets/js/dashboard.js"></script>
    <script src="/socket.io/socket.io.js"></script>

    <script>
      // 3. Hide loader once window is loaded
      window.onload = function () {
        document.getElementById("loader").style.display = "none";
      };

      function handleBusClick(busId) {
        window.location.href = `/admin/CDB/${busId}`;
      }
    </script>

    <script>
          const user = <%- JSON.stringify(user) %>;
          const socket = io({
            query: {
              adminId: user._id
            },
            reconnection: true,             // Enable automatic reconnection
      reconnectionAttempts: Infinity, // Try forever
      reconnectionDelay: 5000,        // Wait 5 seconds before retrying
      reconnectionDelayMax: 10000,    // Max delay between attempts
      timeout: 20000,
          });


          setInterval(() => {
        socket.emit("💓"); // can be any light event like "ping" or "💓"
      }, 2000); // Every 5 seconds (you can try 10000 = 10 sec if stable)
          // Hide all live buses from DOM
          socket.emit("liveBuses", function (response) {
            if (response.success) {
              const liveBusIds = response.data || [];

              // First show all buses
              const allBusCards = document.querySelectorAll(".bus-col");
              allBusCards.forEach((card) => {
                card.style.display = "block";
              });

              // Then hide the live ones
              liveBusIds.forEach((busId) => {
                const el = document.getElementById(busId);
                if (el) {
                  el.style.display = "none";
                }
              });

              console.log("🚍 Inactive buses are now visible.");
            } else {
              console.warn("⚠️ Could not fetch live buses.");
            }
          });

          // Optional: update when a new bus goes online/offline in real time
          socket.on("add", (busId) => {
            const el = document.getElementById(busId);
            if (el) el.style.display = "none"; // hide when bus goes live
          });

          socket.on("remove", (busId) => {
            const el = document.getElementById(busId);
            if (el) el.style.display = "block"; // show when bus goes offline
          });
    </script>
    <script type="module" src="/foreground.js"></script>

    <!-- End custom js for this page -->
  </body>
</html>
