    <style>
      .card {
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        background-color: #f9f9f9;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        transition: 0.3s ease;
      }

      .card:hover {
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
      }

      .card h5 a {
        color: #2c3e50;
        font-weight: 600;
      }

      .card h5 a:hover {
        color: #1e2e3e;
        text-decoration: underline;
      }

      .card-body {
        padding: 1.5rem;
      }

      .card h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #2c3e50;
      }

      .card h5 {
        font-size: 1.1rem;
        margin-bottom: 1rem;
      }

      .icon-lg {
        font-size: 2.2rem;
        opacity: 0.8;
      }

      .vehicle-moving {
        animation: moveIcon 1.8s infinite linear;
      }

      @keyframes moveIcon {
        0% {
          transform: translateX(0);
        }
        50% {
          transform: translateX(2px);
        }
        100% {
          transform: translateX(0);
        }
      }
    </style>
  </head>
