    <!-- custom Script -->

    <script type="module">
      import { fetchToken, sendTokenToServer } from "/afirebase.js";

      // Helper: Check if a cookie exists
      function getCookie(name) {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(";").shift();
      }

      // 1. If cookie exists, do nothing (admin refreshed the page)
      if (getCookie("fcmTokenExpiry")) {
        console.log("Cookie exists — skipping token logic (page refresh).");
      } else {
        // 2. Check localStorage token validity
        const fcmToken = localStorage.getItem("fcmToken");
        const expiryDateStr = localStorage.getItem("fcmTokenExpiryDate");

        let isTokenValid = false;

        if (fcmToken && expiryDateStr) {
          const now = new Date();
          const expiryDate = new Date(expiryDateStr);
          if (now < expiryDate) {
            isTokenValid = true;
          }
        }

        if (!fcmToken || !isTokenValid) {
          fetchToken();
        } else {
          const expiryDate = new Date(expiryDateStr); // 🔥 Convert string to Date object
          sendTokenToServer(fcmToken, expiryDate);
        }
      }

      // 3. Hide loader once window is loaded
      window.onload = function () {
        document.getElementById("loader").style.display = "none";
      };
    </script>
    <script src="/socket.io/socket.io.js"></script>

    <script>
                        const user = <%- JSON.stringify(user) %>;
                        const totalCount = <%- totalCount %>; // ✅ Passed from backend

                        const socket = io({
                          query: {
                            adminId: user._id
                          },
                          reconnection: true,             // Enable automatic reconnection
              reconnectionAttempts: Infinity, // Try forever
              reconnectionDelay: 5000,        // Wait 5 seconds before retrying
              reconnectionDelayMax: 10000,    // Max delay between attempts
              timeout: 20000,
                        });


                        setInterval(() => {
        socket.emit("💓"); // can be any light event like "ping" or "💓"
      }, 2000); // Every 5 seconds (you can try 10000 = 10 sec if stable)

                        socket.on("connect_error", (err) => {
                    console.error("❌ Socket connect error:", err.message);
                  });
                        // DOM elements for count
                        const liveCount = document.getElementById("live");
                        const offlineCount = document.getElementById("offline");

                        // Initialize counters
                        let live = 0;
                        let offline = totalCount;

                        // 🔌 Request live buses from server
                        socket.emit("liveBuses", function (response) {
                          if (response.success) {
                            const liveBusIds = response.data || [];

                            if (liveBusIds.length === 0) {
                              // ✅ No live buses
                              live = 0;
                              offline = totalCount;
                            } else {
                              live = liveBusIds.length;
                              offline = totalCount - live;
                            }

                            // Update DOM
                            liveCount.innerText = live;
                            offlineCount.innerText = offline;

                            console.log(`🟢 Live: ${live}, 🔴 Offline: ${offline}`);
                          } else {
                            // Server failed to send data — keep safe fallback
                            live = 0;
                            offline = totalCount;

                            liveCount.innerText = live;
                            offlineCount.innerText = offline;

                            console.warn("❌ Could not fetch live buses.");
                          }
                        });

                        // 📈 When a bus comes online
                        socket.on("add", (busId) => {
                          if (live < totalCount) {
                            live++;
                            offline = Math.max(0, totalCount - live);
                          }

                          liveCount.innerText = live;
                          offlineCount.innerText = offline;
                          console.log(`✅ Bus ${busId} went live. 🟢 Live: ${live}, 🔴 Offline: ${offline}`);
                        });

                        // 📉 When a bus goes offline
                        socket.on("remove", (busId) => {
                          if (live > 0) {
                            live--;
                            offline = Math.min(totalCount, totalCount - live);
                          }

                          liveCount.innerText = live;
                          offlineCount.innerText = offline;
                          console.log(`❌ Bus ${busId} went offline. 🟢 Live: ${live}, 🔴 Offline: ${offline}`);
                        });
    </script>
    <!-- Chart.js Library -->

    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
      const ctx = document.getElementById('vehicleStatusChart').getContext('2d');

      const operational = <%= operationalCount %>;
      const total = <%= totalCount %>;
      const outOfService = total - operational;

      new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: ['Operational', 'Out of Service'],
          datasets: [{
            data: [operational, outOfService],
            backgroundColor: [
              'rgba(40, 167, 69, 0.8)',   // Green
              'rgba(220, 53, 69, 0.8)'    // Red
            ],
            borderColor: '#fff',
            borderWidth: 2
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                color: '#333',
                font: {
                  size: 14
                }
              }
            }
          }
        }
      });
    </script>
