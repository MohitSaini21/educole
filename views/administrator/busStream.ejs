<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= bus.busNumber %></title>
    <style>
      body,
      html {
        margin: 0;
        padding: 0;
        height: 100%;
        font-family: sans-serif;
        overflow: hidden;
      }

      #adminVideo {
        position: fixed;
        top: 0;

        transform: scaleX(-1); /* Unmirrored view */
        left: 0;
        width: 100vw;
        height: 100vh;
        object-fit: cover;
        z-index: -1;
      }

      .bus-number {
        position: absolute;
        top: 10px;
        left: 20px;
        font-size: 1.5em;
        font-weight: bold;
        background: rgba(0, 0, 0, 0.6);
        color: #fff;
        padding: 8px 16px;
        border-radius: 8px;
        z-index: 2;
      }

      h2 {
        font-size: 2em;
        font-weight: bold;
        text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.8);
      }

      .bus-number {
        cursor: pointer;
        color: #007bff;
      }

      .bus-number:hover {
        opacity: 0.8;
      }
      .disappear {
        display: none !important;
      }
    </style>
    <link
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- Bus Number Top Right -->
    <!-- Toggle Button for Start/Stop Stream -->
    <!-- <button class="bus-number" onclick="toggleStream(this)" id="streamBtn">
