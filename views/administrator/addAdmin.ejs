<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <title>TMU </title>
    <!-- plugins:css -->
    <link
      rel="stylesheet"
      href="/assets/vendors/mdi/css/materialdesignicons.min.css"
    />
    <link rel="stylesheet" href="/assets/vendors/css/vendor.bundle.base.css" />
    <!-- endinject -->
    <!-- Plugin css for this page -->

    <link rel="stylesheet" href="/assets/loader.css" />
    <!-- End plugin css for this page -->
    <!-- inject:css -->
    <!-- endinject -->
    <!-- Layout styles -->
    <link rel="stylesheet" href="/assets/css/style.css" />
    <!-- End layout styles -->
  </head>
  <body>
    <div class="container-scroller">
      <!-- partial:partials/_sidebar.html -->

      <%- include('../corePartials/sidebar.ejs') %>
      <!-- partial -->
      <div class="container-fluid page-body-wrapper">
        <!-- partial:partials/_navbar.html -->

        <%- include('../corePartials/nav.ejs') %>
        <!-- partial -->
        <div class="main-panel">
          <div class="content-wrapper">
            <div class="row" id="mainRow">
              <div class="col-12 grid-margin stretch-card">
                <div class="card">
                  <div class="card-body">
                    <h4 class="card-title">Add New Admin</h4>
                    <p class="card-description">
                      Please provide the following details.
                      <code>Note:</code> Password and Admin ID will be generated
                      automatically.
                    </p>
                    <form id="adminForm" class="form-inline">
                      <div class="form-group mb-3 mr-3">
                        <label for="email" class="mr-2">Email</label>
                        <input
                          type="email"
                          class="form-control"
                          id="email"
                          placeholder="Enter email"
                          required
                        />
                      </div>

                      <div class="form-group mb-3 mr-3">
                        <label for="username" class="mr-2">Username</label>
                        <input
                          type="text"
                          class="form-control"
                          id="username"
                          placeholder="Enter username"
                          required
                        />
                      </div>

                      <button type="submit" class="btn btn-primary">
                        Submit
                      </button>
                    </form>
                  </div>
                </div>
              </div>
              <% if (locals.admins && admins.length > 0) { %> <%
              admins.forEach(admin => { %>
              <div
                class="col-md-6 col-xl-4 grid-margin stretch-card"
                id="<%=admin._id  %>"
              >
                <div class="card">
                  <div class="card-body">
                    <h4 class="card-title"><%= admin.username %></h4>
                    <button
                      type="button"
                      class="btn"
                      onclick="copyCredentials('<%= admin.adminId %>', '<%= admin.password %>')"
                    >
                      <i class="mdi mdi-arrange-send-backward"></i>
                    </button>

                    <div class="d-flex py-4" id="<%=admin._id  %>">
                      <div class="preview-list w-100">
                        <div class="preview-item p-0">
                          <div class="preview-thumbnail">
                            <img
                              src="https://waliaglobalacademy.in/wp-content/uploads/2024/06/cropped-walia-global-logo1.jpg"
                              class="rounded-circle"
                              alt=""
                            />
                          </div>
                          <div class="preview-item-content d-flex flex-grow">
                            <div class="flex-grow">
                              <div
                                class="d-flex d-md-block d-xl-flex justify-content-between"
                              >
                                <h6 class="preview-subject">
                                  <%= admin.username %>
                                </h6>
                              </div>
                              <p class="text-muted text-small">
                                Created at: <%= admin.createdAt.toLocaleString()
                                %>
                              </p>
                              <p class="text-muted">
                                Password: <%= admin.password %>
                              </p>
                              <p class="text-muted">
                                Email: <%= admin.email %>
                              </p>
                              <p class="text-muted">
                                AdminID: <%= admin.adminId %>
                              </p>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- Delete and Update buttons -->
                    <div class="mt-4">
                      <button
                        class="btn btn-danger btn-sm"
                        onclick="deleteAdmin('<%= admin._id %>')"
                      >
                        Delete
                      </button>
                    </div>
                  </div>
                </div>
              </div>
              <% }) %> <% } else { %> <% } %>
            </div>
          </div>
          <!-- content-wrapper ends -->
          <!-- partial:partials/_footer.html -->
          <%- include('../corePartials/footer.ejs') %>
          <%-include('../corePartials/loader.ejs') %>
          <!-- partial -->
        </div>
        <!-- main-panel ends -->
      </div>
      <!-- page-body-wrapper ends -->
    </div>

    <!-- container-scroller -->
    <!-- customr Script -->
    <script>
      function copyCredentials(id, password) {
        const text = `Admin ID: ${id}\nPassword: ${password}`;
        navigator.clipboard
          .writeText(text)
          .then(() => alert("Admin ID and password copied to clipboard!"))
          .catch((err) => alert("Failed to copy: " + err));
      }

      async function deleteAdmin(id) {
        if (!id) {
          console.error("Admin ID is required to delete.");
          return;
        }

        // Optional: confirmation prompt
        const confirmDelete = confirm(
          "Are you sure you want to delete this admin?"
        );
        if (!confirmDelete) return;

        document.getElementById("loader").style.display = "flex";

        try {
          const response = await fetch(`/administrator/settings/deleteAdmin`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ id }), // pass id in body if needed on server
          });

          const result = await response.json();

          if (response.ok && result.done) {
            document.getElementById("loader").style.display = "none";
            alert("Admin deleted successfully!");
            document.getElementById(id).style.display = "none";
          } else {
            document.getElementById("loader").style.display = "none";
            alert(
              "Failed to delete admin: " + (result.message || "Unknown error")
            );
          }
        } catch (err) {
          document.getElementById("loader").style.display = "none";
          console.error("Error:", err);
          alert("Something went wrong while deleting admin.");
        }
      }
    </script>

    <script>
      document
        .getElementById("adminForm")
        .addEventListener("submit", async function (e) {
          e.preventDefault();

          const email = document.getElementById("email").value.trim();
          const username = document.getElementById("username").value.trim();

          // You can optionally validate here if needed

          const data = {
            email,
            username,
          };

          document.getElementById("loader").style.display = "flex";

          // Optional: Send data to your backend
          try {
            const response = await fetch("/administrator/settings/addAdmin", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify(data),
            });

            const result = await response.json();
            if (result.done) {
              console.log("Server response:", result);
              document.getElementById("loader").style.display = "none";
              append(result.newAdmin);
              alert("Admin added successfully!");
            } else {
              document.getElementById("loader").style.display = "none";
              alert(result.message);
            }
          } catch (err) {
            document.getElementById("loader").style.display = "none";
            console.error("Error submitting form:", err);
            alert("Something went wrong. Please try again.");
          }
        });

      function append(admin) {
        const mainRow = document.getElementById("mainRow");

        const col = `
      <div class="col-md-6 col-xl-4 grid-margin stretch-card" id=${admin._id}>
                <div class="card">
                  <div class="card-body">
                    <h4 class="card-title">${admin.username}</h4>
                                   <button
                      type="button"
                      class="btn"
                      onclick="copyCredentials(' ${admin.adminId}', ${
          admin.password
        }')"
                    >
                      <i class="mdi mdi-arrange-send-backward"></i>
                    </button>


                    <div class="d-flex py-4">
                      <div class="preview-list w-100">
                        <div class="preview-item p-0">
                          <div class="preview-thumbnail">
                            <img
                              src="https://waliaglobalacademy.in/wp-content/uploads/2024/06/cropped-walia-global-logo1.jpg"
                              class="rounded-circle"
                              alt=""
                            />
                          </div>
                          <div class="preview-item-content d-flex flex-grow">
                            <div class="flex-grow">
                              <div
                                class="d-flex d-md-block d-xl-flex justify-content-between"
                              >
                                <h6 class="preview-subject">
                                ${admin.username}
                                </h6>
                              </div>
                               <p class="text-muted text-small">
                                Created at: ${admin.createdAt.toLocaleString()}
                              </p>
                              <p class="text-muted">
                                Password: ${admin.password}
                              </p>
                              <p class="text-muted">
                                Email: ${admin.email}
                              </p>
                              <p class="text-muted">
                                AdminID: ${admin.adminId}
                              </p>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- Delete and Update buttons -->
                    <div class="mt-4">
           
                        
                      <button
                        class="btn btn-danger btn-sm"
                        onclick="deleteAdmin('${admin._id}')"
                      >
                        Delete
                      </button>
                    </div>
                  </div>
                </div>
              </div>
  `;

        const tempDiv = document.createElement("div");
        tempDiv.innerHTML = col.trim();
        const newCol = tempDiv.firstChild;

        mainRow.appendChild(newCol); // ✅ This appends it at the end
      }
      window.onload = function () {
        document.getElementById("loader").style.display = "none";
      };
    </script>

    <!-- customr Script -->
    <!-- plugins:js -->
    <script src="/assets/vendors/js/vendor.bundle.base.js"></script>
    <!-- endinject -->
    <!-- Plugin js for this page -->

    <!-- End plugin js for this page -->
    <!-- inject:js -->
    <script src="/assets/js/off-canvas.js"></script>
    <script src="/assets/js/hoverable-collapse.js"></script>
    <script src="/assets/js/misc.js"></script>
    <script src="/assets/js/settings.js"></script>
    <script src="/assets/js/todolist.js"></script>
    <!-- endinject -->
    <!-- Custom js for this page -->
    <script src="/assets/js/dashboard.js"></script>
    <script type="module" src="/foreground.js"></script>
    <!-- End custom js for this page -->
  </body>
</html>
