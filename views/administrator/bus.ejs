<script>
  function deleteStop(stopId, busId,btn) {
    if (!confirm("❗ Are you sure you want to delete this stop?")) return;

    btn.innerText = "⏳ Deleting...";

    fetch(`/administrator/settings/deleteStop/${busId}/${stopId}`, {
      method: "DELETE"
    })
    .then(res => res.json())
    .then(data => {
      alert(data.message);

      if (data.code === "SUCCESS") {
        // Optionally remove the row from DOM if successful
        document.getElementById(`stopRow-${stopId}`).remove();
      }
      btn.innerText = "🗑️";
    })
     
    
    .catch(err => {
      btn.innerText = "🗑️";
      console.error("❌ Error:", err);
      alert("⚠️ Something went wrong while deleting the stop.");
    });
  }

