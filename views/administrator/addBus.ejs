     <script>

function getFormData(id) {
  const form = document.getElementById(id);  // Get the form by its ID
  const formData = {};

  // Loop through each form element and collect its value
  Array.from(form.elements).forEach(element => {

  
    
        formData[element.id] = element.value || '';  // Get the value of other inputs (e.g., text, date)

        
    
        
  });

  return formData;
}

function getBusData(formId) {
  // Get the form element using the provided ID
  const form = document.getElementById(formId);
  
  // Collecting form data
  const formData = new FormData(form);

  // Converting FormData to a JSON object
  const data = {};

  formData.forEach((value, key) => {
    if (key.includes("stopName") || key.includes("morningTime") || key.includes("eveningTime") || key.includes("latitude") || key.includes("longitude") || key.includes("stopOrder")) {
      // Handle array inputs like stopName[], morningTime[], eveningTime[], latitude[], longitude[]
      if (!data[key]) {
        data[key] = [];
      }
      data[key].push(value);
    } else {
      data[key] = value; // Handle single input values like busNumber, route, etc.
    }
  });

  const uniqueOrders = new Set(data["stopOrder[]"]);

if (uniqueOrders.size !==data["stopOrder[]"].length) {

  
  alert("❌ Stop Order numbers must be unique. Please fix duplicates.");
  return
}

  // Formatting stops array with their times and coordinates for better structure
  const stops = [];
  for (let i = 0; i < data["stopName[]"].length; i++) {
    if (data["stopName[]"][i]) {
      stops.push({
        stopName: data["stopName[]"][i],
        morningTime: data["morningTime[]"][i],
        eveningTime: data["eveningTime[]"][i],
        latitude: data["latitude[]"][i],    // Add latitude for the stop
        longitude: data["longitude[]"][i],  // Add longitude for the stop
        stopOrder: data["stopOrder[]"][i],  // Add longitude for the stop
      });
    }
  }

  // Constructing final data object to return
  const finalData = {
    busNumber: data.busNumber,
    route: data.route,
    capacity: data.capacity ? data.capacity : "",
    status: data.status ? data.status : "",
    fuelType: data.fuelType ? data.fuelType : "",
    lastServiced: data.lastServiced ? data.lastServiced : "",
   
    
    stops: stops,
      distanceTravelled:data.distanceTravelled ? data.distanceTravelled : 0,
        averageSpeed:data.averageSpeed ? data.averageSpeed : 0,

  };

  return finalData; // Return the final data object
}

function validateBusData(busData) {
  // Check required fields
  if (!busData.busNumber?.trim() || !busData.route?.trim()) {
    alert(`Bus number and route are required.`);
    return false;
  }else if(!busData.status?.trim()  || !busData.fuelType?.trim()){
    alert(`Select status and fuelType.`);
    return false;
  }else if(busData.stops.length==0){
  alert("Atleast Add one stop")
  return false;
  }else{
  // Check each stop's fields
  for (let i = 0; i < busData.stops.length; i++) {
    const stop = busData.stops[i];
    for (const [key, value] of Object.entries(stop)) {
      if (value === null || value === undefined || value.trim() === "") {
        alert(`Please fill all fields for stop "${stop.stopName || `#${i + 1}`}" — missing "${key}".`);
        return false;
      }
    }
  }
  }



  return true; // All good
}



function Collect() {


  const busData = getBusData("eventForm");


  console.log(busData)


  
  

  if (!validateBusData(busData)) {
  return; // Stop form submission
}





  

  
// Helper function to validate required fields
function validateRequiredFields(data, fields) {
  for (const field of fields) {
    if (!data[field]?.trim()) {
      alert(`${field} is required!`);
      
      return false;
    }
  }
  return true;
}

// --- Driver Form Validation ---
const driverData = getFormData("driverForm");
if (!validateRequiredFields(driverData, ["driverName", "driverPhone"])) {
  // Error already shown by helper function
  return; // Stop execution if invalid
}

// --- Conductor Form Validation ---
const conductorData = getFormData("conductorForm");
if (!validateRequiredFields(conductorData, ["conductorName", "conductorPhone"])) {
  // Error already shown by helper function
  return; // Stop execution if invalid
}

// If we reach here, all data is valid!
console.log("Driver Data:", driverData);
console.log("Conductor Data:", conductorData);
  

  

  // Create an array of objects
  const formDataArray = [
    {
      type: 'bus',
      data: busData
    },
    {
      type: 'driver',
      data: driverData
    },
    {
      type: 'conductor',
      data: conductorData
    }
  ];

  console.log(formDataArray)
  document.getElementById("loader").style.display = "flex";

  fetch('/administrator/settings/addBus', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify(formDataArray),
  })
  .then(response   => response.json())
  .then(data => {

    document.getElementById("loader").style.display = "none";
    alert(data.message)
    if (data.code === "SUCCESS") {
  const forms = ["eventForm", "driverForm", "ConductorForm"];

  forms.forEach((formId) => {
    const form = document.getElementById(formId);
    if (form) form.reset(); // Reset only if form exists
  });

  // Optional: show a success message

  setTimeout(() => {
    
    window.location.href="/admin/garrage"
  }, 2000);
  console.log("✅ All forms have been reset successfully.");
}

  })
  .catch((error) => {
    console.log(error.message)
    console.error('Error:', error);
  });
}




  
  
  
     </script>


