async function fixed(busId) {
    const group = markerCache[busId];
  if (!group) {
    console.warn(`No group found for busId: ${busId}`);
    return;
  }

  // A LayerGroup can contain multiple layers (marker, circle, etc.)
  let marker;

  group.eachLayer(layer => {
    if (layer instanceof L.Marker) {
      marker = layer;
    }
  });
  if(marker){
   marker.fire('click');
  }

}


function updateBusPopup(busId, html) {
  const group = markerCache[busId];
  if (!group) {
    console.warn(`No group found for busId: ${busId}`);
    return;
  }

  // A LayerGroup can contain multiple layers (marker, circle, etc.)
  let marker;

  group.eachLayer(layer => {
    if (layer instanceof L.Marker) {
      marker = layer;
    }
  });

  if (marker) {
    marker.setPopupContent(html);
    console.log(`✅ Popup updated for busId: ${busId}`);
  } else {
    console.warn(`❌ Marker not found inside group for busId: ${busId}`);
  }
}




