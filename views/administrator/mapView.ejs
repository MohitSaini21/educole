}

 async function worker(busId) {
    console.log("Worker function has been called");

    socket.emit("lastDrived", { busId }, (worker) => {
      console.log("Callback from server received:", worker);

      if (worker) {
 
        
        let html=getWorkerPopupHTML(worker,busId)
        updateBusPopup(busId,html)
        
      } else {
       const errorHTML = `
    <div style="width: 250px; color: red;">
      No worker present in database. Please contact the developer.
    </div>
  `;

 
  


         updateBusPopup(busId,html)
        alert("No worker present in database. Please contact the developer.");
      }
    });
  }



