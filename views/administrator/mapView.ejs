      subdomains: ["mt0", "mt1", "mt2", "mt3"]
    }
  );

  var googleHybrid = L.tileLayer(
    "http://{s}.google.com/vt/lyrs=s,h&x={x}&y={y}&z={z}",
    {
      maxZoom: 20,
      subdomains: ["mt0", "mt1", "mt2", "mt3"]
    }
  );

  var googleSat = L.tileLayer(
    "http://{s}.google.com/vt/lyrs=s&x={x}&y={y}&z={z}",
    {
      maxZoom: 20,
      subdomains: ["mt0", "mt1", "mt2", "mt3"]
    }
  );

  var googleTerrain = L.tileLayer(
    "http://{s}.google.com/vt/lyrs=p&x={x}&y={y}&z={z}",
    {
      maxZoom: 20,
      subdomains: ["mt0", "mt1", "mt2", "mt3"]
    }
  );

  // Initialize the map with a default layer
  var map = L.map("map", {
    center: [29.4426,78.4327],
    zoom: 30,
    layers: [googleTerrain], // default layer

    
  });


  
  // Define base maps
  var baseMaps = {
    "Google Streets": googleStreets,
    "Google Terrain": googleTerrain,
    "Google Satellite": googleSat,
    "Google Hybrid": googleHybrid
  };

  

  
  // Global layerGroup to hold all bus markers
const busLayerGroup = L.layerGroup().addTo(map);

// Also register it in layer control (optional but good)
const overlays = {
  "🚌 Active Buses": busLayerGroup
};
L.control.layers(baseMaps, overlays,{
                       position: 'topleft' // or 'topleft', 'topright', 'bottomright'
                     }).addTo(map);

// Cache to track markers by busId
const markerCache = {};

const BusIcon = L.Icon.extend({
  options: {
    iconSize: [60, 45],
    iconAnchor: [19, 45],
    popupAnchor: [0, -40]
  }
});



socket.on("allBusLocations", (data) => {
  console.log(data)
  const busId = data.bus._id;
  const lat = data.latitude;
  const lng = data.longitude;

  




  




  if (markerCache[busId]) {
  const group = markerCache[busId];

  // 🔍 Extract marker and circle from the group
  const layers = group.getLayers();
  const marker = layers[0]; // assuming marker is first
  const accuracyCircle = layers[1]; // and circle is second

  // ✅ Move the marker smoothly
  marker.slideTo([lat, lng], { duration: 1000 });
  console.log("📍 Updating the marker and accuracy...");

  // ✅ Move and resize the accuracy circle
  accuracyCircle.setLatLng([lat, lng]);
  accuracyCircle.setRadius(data.accuracy || 100); // fallback 100m if not sent

  // ✅ If popup is open, update the "Last updated" field
  const popup = marker.getPopup();
  if (popup && popup.isOpen()) {
    const popupEl = document.querySelector(".leaflet-popup-content");
    const lastUpdatedEl = popupEl?.querySelector(".last-updated");
    const accuracyUpdatedEI=popupEl?.querySelector(".accuracy-updated")
    if (lastUpdatedEl) {
      lastUpdatedEl.textContent = `Last updated: ${new Date(data.timestamp).toLocaleString()}`;
    }
    if(accuracyUpdatedEI){
      accuracyUpdatedEI.textContent=  `Accuracy: ±${Math.round(data.accuracy)} meters`
    }
  
  }
}
 else {
 
    

        // Create new marker and add to LayerGroup
        const busIcon = new BusIcon({ iconUrl: data.bus.iconPhoto });
console.log("creating the marker.................................");

// Marker
const marker = L.marker([lat, lng], { icon: busIcon });

// Accuracy circle
const accuracyRadius = data.accuracy || 100;
console.log("Accuracy Radius:", accuracyRadius); // ✅ Check what's being passed

const accuracyCircle = L.circle([lat, lng], {
  radius: accuracyRadius,
  color: "#3498db",
  fillColor: "#3498db",
  fillOpacity: 0.2,
  weight: 1,
});

// Combine both in a group
const group = L.layerGroup([marker, accuracyCircle]);

// Cache and add
markerCache[busId] = group;
busLayerGroup.addLayer(group); // ✅ Critical step!

    marker.on("click", async () => {
  const loaderContent = `
    <div style="width: 250px; text-align: center;">
      <p>Loading bus details...</p>
      <div class="loader"></div>
    </div>
  `;

  marker.unbindPopup();
  marker.bindPopup(loaderContent).openPopup();

  try {
  const response = await fetch(`/admin/bus/${busId}`);

  if (!response.ok) {
    const errorResponse = await response.json();
    throw new Error(errorResponse.message || "Unknown server error");
    return
  }

  const busData = await response.json();


   const html=getBusPopupHTML(busData, data.timestamp, accuracyRadius);


  
   


  marker.setPopupContent(html);
} catch (err) {
  console.error("❌ Failed to fetch bus data:", err);

  const errorHTML = `
    <div style="width: 250px; color: red;">
      ${err.message}
    </div>
  `;

  marker.setPopupContent(errorHTML);
}

});


    

    
    
    busLayerGroup.addLayer(marker);

    
  }

  

});








socket.emit("lastLocationOfAllBuses", (data) => {
  if (!data || !Array.isArray(data)) {
    console.warn("⚠️ No location data available.");
    return;
  }

  console.log("📍 Got last known location:", data);



  for (const busData of data) {
    
    

    const busId = busData.bus._id;

if (markerCache[busId]) {
  continue; // ✅ This works inside for...of
}

console.log(busData); // ✅ Will not error now
  const lat = busData.latitude;
  const lng =busData.longitude;
  const accuracy=busData.accuracy;


    // Create custom icon
    const busIcon = new BusIcon({ iconUrl: busData.bus.iconPhoto });
    console.log("🆕 Creating marker for:", busId);

    // Marker
    const marker = L.marker([lat, lng], { icon: busIcon });

    // Accuracy circle
    const accuracyCircle = L.circle([lat, lng], {
      radius: accuracy,
      color: "#3498db",
      fillColor: "#3498db",
      fillOpacity: 0.2,
      weight: 1,
    });

    // Grouping both marker + circle
    const group = L.layerGroup([marker, accuracyCircle]);

    // Cache and add to map
    markerCache[busId] = group;
    busLayerGroup.addLayer(group);

    // Popup interaction
    marker.on("click", async () => {
      const loader = `
        <div style="width: 250px; text-align: center;">
          <p>Loading bus details...</p>
          <div class="loader"></div>
        </div>
      `;
      marker.unbindPopup();
      marker.bindPopup(loader).openPopup();

      try {
        const res = await fetch(`/admin/bus/${busId}`);
        if (!res.ok) {
          const errRes = await res.json();
          throw new Error(errRes.message || "Server error");
        }

        const detailed = await res.json();

        const popupHtml = getBusPopupHTML(detailed, busData.timestamp,  accuracy);
        marker.setPopupContent(popupHtml);
      } catch (err) {
        console.error("❌ Failed to fetch bus data:", err);
        marker.setPopupContent(`
          <div style="width: 250px; color: red;">
            ${err.message}
          </div>
        `);
      }
    });

  }
});


function expandMapFullScreen() {
  const mapContainer = document.querySelector(".col-md-12.grid-margin");
  if (mapContainer) {
    mapContainer.classList.add("fullscreen-map");
  }
}

function exitFullScreenMap() {
  const mapContainer = document.querySelector(".col-md-12.grid-margin");
  if (mapContainer) {
    mapContainer.classList.remove("fullscreen-map");
  }
}

// Detect Ctrl+M and Ctrl+V
document.addEventListener("keydown", function (e) {
  if (e.ctrlKey && e.key.toLowerCase() === "m") {
    expandMapFullScreen();
  }
  if (e.ctrlKey && e.key.toLowerCase() === "v") {
    exitFullScreenMap();
  }
});



function getBusPopupHTML(busData, timestamp, accuracy) {
  return `
    <style>
      .leaflet-popup-content { margin: 0 !important; }
      .bus-card {
        font-family: "Segoe UI", sans-serif;
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.1);
        padding: 16px;
        max-width: 360px;
        color: #2c3e50;
      }
      .bus-card:hover { box-shadow: 0 6px 18px rgba(0,0,0,0.15); }
      .bus-title {
        text-align: center;
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 10px;
        color: #333;
      }
      .bus-info {
        text-align: center;
        font-size: 14px;
        color: #555;
        margin-bottom: 10px;
      }
      .crew { display: flex; justify-content: space-between; margin-top: 12px; }
      .crew-member { flex: 1; text-align: center; }
      .crew-photo {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        object-fit: cover;
        margin-bottom: 6px;
        border: 2px solid #eee;
      }
      .crew-name { font-weight: bold; font-size: 13px; }
      .crew-phone { font-size: 12px; color: #777; }
      .actions { text-align: center; margin-top: 12px; }
      .action-btn {
        margin: 4px;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 13px;
        text-decoration: none;
        display: inline-block;
        transition: 0.2s;
      }
      .call-btn { background: #3498db; color: white; }
      .call-btn:hover { background: #2980b9; }
      .track-btn { background: #2ecc71; color: white; }
      .track-btn:hover { background: #27ae60; }
      .last-updated, .accuracy-updated {
        text-align: center;
        font-size: 12px;
        margin-top: 6px;
        color: #777;
      }
    </style>

    <div class="bus-card">
      <div class="bus-title">🚌 Bus No: ${busData.busNumber}</div>

      <div class="bus-info">📍 <b>Route:</b> ${busData.route}</div>
      <div class="bus-info">👥 <b>Capacity:</b> ${busData.capacity} | ⛽ <b>Fuel:</b> ${busData.fuelType}</div>

      <div class="crew">
        <div class="crew-member">
          <img src="${busData.driver?.profilePhoto || 'default-driver.jpg'}" class="crew-photo" alt="Driver">
          <div class="crew-name">${busData.driver?.name || "N/A"}</div>
          <div class="crew-phone">📞 ${busData.driver?.phone || "N/A"}</div>
        </div>
        <div class="crew-member">
          <img src="${busData.conductor?.profilePhoto || 'default-conductor.jpg'}" class="crew-photo" alt="Conductor">
          <div class="crew-name">${busData.conductor?.name || "N/A"}</div>
          <div class="crew-phone">📞 ${busData.conductor?.phone || "N/A"}</div>
        </div>
      </div>

      <div class="actions">
        <a href="/admin/particularBusLive/${busData._id}" class="action-btn track-btn">📍 Track</a>
        <a href="tel:${busData.driver?.phone || ''}" class="action-btn call-btn">Call Driver</a>
        <a href="tel:${busData.conductor?.phone || ''}" class="action-btn call-btn">Call Conductor</a>
      </div>

      <div class="last-updated">
        Last updated: ${new Date(timestamp).toLocaleString()}
      </div>
      <div class="accuracy-updated">
        Accuracy: ±${Math.round(accuracy)} meters
      </div>
