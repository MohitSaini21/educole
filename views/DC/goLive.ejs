<style>
#videoIframe {
  width: 100%;
  height: 100%;
}


.fullscreen-map {
  position: fixed !important;
  top: 0;
  left: 0;
  width: 100vw !important;
  height: 100vh !important;
  z-index: 5000; /* Highest safe z-index */
  background-color: white;
  animation: fadeInMap 0.4s ease-in-out forwards;
  overflow: hidden;
  margin: 0;
  padding: 0;
}

@keyframes fadeInMap {
  0% {
    opacity: 0;
    transform: scale(0.98);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}


.shrink-map {
  animation: fadeOutMap 0.4s ease-in-out forwards;
}

@keyframes fadeOutMap {
  0% {
    opacity: 1;
    transform: scale(1);
  }
  100% {
    opacity: 0.7;
    transform: scale(0.98); /* Slight shrink for realism */
  }
}


#driverVideo {
  width: 100%;      /* Makes the video take the full width of the parent */
  height: 100%;     /* Makes the video take the full height of the parent */
  object-fit: cover; /* Ensures the aspect ratio is maintained, and it covers the parent container */
}


 /* Light transparent backdrop */
 .modal-backdrop {
    background-color: rgba(255, 255, 255, 0.6) !important;
    z-index: 2147483646 !important;
  }

  .modal {
    z-index: 2147483647 !important;
  }

  .modal-content {
    background-color: #fefefe; /* Lightest white tone */
    border-radius: 1rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .modal-header, .modal-footer {
    border: none;
  }

  .dropdown-menu {
    border-radius: 0.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  }

  .dropdown-item:hover {
    background-color: #f1f1f1;
  }





</style>

    
  </head>
