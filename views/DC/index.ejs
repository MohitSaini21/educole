<!-- 1. Load the QR library FIRST -->
<script src="/html5-qrcode.min.js"></script>


<!-- 2. THEN run your code -->
<script>
  let html5QrCode = new Html5Qrcode("reader");
 

  // Function to start camera
async function startCamera(cameraId) {
  try {
    // If scanning, stop and wait for cleanup
    if (html5QrCode.isScanning) {
      await html5QrCode.stop();
      console.log("Previous scan stopped safely.");
    }

    // Add active state and start camera
    document.getElementById("reader").classList.add("active");

    await html5QrCode.start(
      cameraId,
      { fps: 10, qrbox: 250 },
      decodedText => {
        window.location.href = `/DC/driverGoLive/${decodedText}`;
      },
      err => console.warn("Scanning...", err)
    );

    console.log("Camera started successfully!");
  } catch (err) {
    console.error("Unable to start scanning:", err);
  }
}


  // Button events
   let isToggle = false;
  document.getElementById("rearBtn").addEventListener("click", () => {
    //    if(isToggled){
    //        isToggled= !isToggled;
    // }
    isToggled=false;
     isToggle= !isToggle;

        if (isToggle) {
    Html5Qrcode.getCameras().then(cameras => {
      // pick first back-facing camera
      const rear = cameras.find(cam => /back|rear/i.test(cam.label)) || cameras[0];
      startCamera(rear.id);
    });
    } else {
      console.log("Button is now OFF");
       if (html5QrCode.isScanning) {
      html5QrCode.stop().then(() =>{ 
        document.getElementById("reader").classList.remove("active");

        console.log("Scanning has been stoped")});
    } 
      // Do OFF action
    }
  
  });
   let isToggled = false;

  document.getElementById("frontBtn").addEventListener("click", () => {
    // if(isToggle){
    //        isToggle= !isToggle;
    // }
    isToggle=false;

     isToggled = !isToggled;
      if (isToggled) {
     Html5Qrcode.getCameras().then(cameras => {
      // pick first front-facing camera
      const front = cameras.find(cam => /front|user/i.test(cam.label)) || cameras[0];
      startCamera(front.id);
    });
    } else {
      console.log("Button is now OFF");
       if (html5QrCode.isScanning) {
      html5QrCode.stop().then(() => {
        document.getElementById("reader").classList.remove("active");

        console.log("Scanning has been stoped")});
    } 
      // Do OFF action
    }
  
  });

  // File upload fallback
  const fileInput = document.getElementById("file-input");
  fileInput.addEventListener("change", async (e) => {
 if (!e.target.files || e.target.files.length === 0) return;
    const imageFile = e.target.files[0];
     // Stop camera if running
  if (html5QrCode.isScanning) {
    document.getElementById("reader").classList.remove("active");

    await html5QrCode.stop();
  }
  // ✅ Hide reader box before scanning image
  const readerElem = document.getElementById("reader");
  // const prevDisplay = readerElem.style.display;
  // readerElem.style.display = "none";

  html5QrCode.scanFile(imageFile, true)
    .then(decodedText => {
      window.location.href = `/DC/driverGoLive/${encodeURIComponent(decodedText)}`;
    })
    .catch(err => alert("No QR code found: " + err))
    .finally(() => {
      e.target.value = ""; // reset input
      // ✅ Restore reader box (if you want camera scanning again)
      readerElem.innerHTML=""
    });

  });
    // Cleanup on page close (best-effort)
  window.addEventListener("beforeunload", () => {
 if (html5QrCode.isScanning) {
  document.getElementById("reader").classList.remove("active");

      html5QrCode.stop().catch(()=>{});
    }
  });
</script>




