  console.warn("📴 Offline — disconnecting socket");
  alert("📴 Offline — disconnecting socket");

  
});

window.addEventListener("online", () => {
  console.warn("🌐 Back online — will reconnect in 5s");
  alert("🌐 Back online — will reconnect in 5s");

  
});
