    .thumb-checkin {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    font-size: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: auto;
    position: relative;
    background-color: #0d6efd;
    color: white;
    box-shadow: 0 0 15px rgba(13, 110, 253, 0.5);
    animation: pulse 1.8s infinite;
    border: none;
    font-weight: bold;
  }

  .thumb-checkin:hover {
    background-color: #0b5ed7;
    box-shadow: 0 0 25px rgba(13, 110, 253, 0.7);
    transform: scale(1.05);
  }

  .thumb-checkin span {
    display: none;
  }

  .thumb-label {
    margin-top: 10px;
    text-align: center;
    font-weight: bold;
    font-size: 16px;
    color: #333;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(13, 110, 253, 0.7);
    }
    70% {
      box-shadow: 0 0 0 20px rgba(13, 110, 253, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(13, 110, 253, 0);
    }
  }


  .thumb-checkout {
  font-size: 2.5rem;
  text-decoration: none;
  color: red;
  background: #ffe5e5;
  border-radius: 50%;
  padding: 12px 18px;
  display: inline-block;
  box-shadow: 0 4px 8px rgba(255, 0, 0, 0.3);
  transition: transform 0.2s ease, background 0.3s;
}

.thumb-checkout:hover {
  background: red;
  color: white;
  transform: scale(1.1);
}

.thumb-label {
  text-align: center;
  font-size: 14px;
  margin-top: 6px;
  color: #444;
  font-weight: 500;
}



    #reader { width: 100%; max-width: 300px; margin: auto; }

    


    .controls {
  display: flex;
  justify-content: center; /* center horizontally */
  gap: 20px;              /* space between buttons */
  margin-top: 15px;
  flex-wrap: wrap;         /* wrap on small screens */
}

.controls button,
.controls label {
  background-color: #007bff;
  color: white;
  border: none;
  padding: 12px 18px;
  font-size: 20px;
  border-radius: 8px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s, transform 0.2s;
}

.controls button:hover,
.controls label:hover {
  background-color: #0056b3;
  transform: scale(1.1);
}

.controls i {
  pointer-events: none; /* so icon doesn’t block clicks */
}

/* Mobile responsiveness */
@media (max-width: 500px) {
  .controls button,
  .controls label {
    font-size: 18px;
    padding: 10px 14px;
  }
}
/* Container for the scanner */
#reader {
  position: relative;
  width: 100%;
  max-width: 400px;
  aspect-ratio: 1 / 1;
  margin: 0 auto;
  border-radius: 20px;
  overflow: hidden;
  display: none; /* hidden before camera starts */
  background: rgba(0, 0, 0, 0.85);
}

/* When camera stream starts */
#reader.active {
  display: block;
  border: 2px solid #ffcc00; /* Bus yellow border */
  box-shadow: 0 0 25px rgba(255, 204, 0, 0.4);
}

/* Live camera feed */
#reader video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Scanning animation line */
#reader::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background: linear-gradient(90deg, transparent, #ffcc00, transparent);
  animation: scan-line 2s linear infinite;
  opacity: 0.9;
}

/* Moving scan line animation */
@keyframes scan-line {
  0% {
    top: 0%;
  }
  100% {
    top: 100%;
  }
}

/* Dark overlay edges for focus */
#reader::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(
    circle at center,
    transparent 65%,
    rgba(0, 0, 0, 0.85) 100%
  );
  pointer-events: none;
}


  

/* Optional: smooth fade-in */
#reader.active {
  animation: fade-in 0.6s ease-in-out;
}

@keyframes fade-in {
  from {
    opacity: 0;
    transform: scale(0.98);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

