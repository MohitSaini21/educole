  </head>
  <body>
    <div class="container-scroller">
      <!-- partial:../../partials/_sidebar.html -->

      <%- include('./partials/sidebar.ejs') %>
      <%- include('./partials/loader.ejs') %>
      <!-- partial -->
      <div class="container-fluid page-body-wrapper">
        <!-- partial:../../partials/_navbar.html -->

        <%- include('./partials/nav.ejs') %>
        <!-- partial -->
<div class="main-panel">
  <div class="content-wrapper">
    <div class="mb-4 text-center">
      <h4 class="fw-bold">बस संख्या: <%= bus.busNumber %> (<%= bus.route %>)</h4>
    </div>

    <% if (isMorning) { %>
      <% if (activity && activity.morningSnap && activity.morningSnap.reading && activity.morningSnap.image) { %>
        <div class="alert alert-success text-center shadow-sm rounded">
          <strong>⏰ शाम की रीडिंग अपलोड करने में बचा समय:</strong><br>
          <%= remainingTime.hours %> घंटे
          <%= remainingTime.minutes %> मिनट
          <%= remainingTime.seconds %> सेकंड
        </div>
      <% } else { %>
        <div class="text-center mb-4">
          <h5 class="fw-semibold text-primary">सुबह की रीडिंग सबमिट करें</h5>
          <p class="text-muted">कृपया नीचे दी गई जानकारी ध्यानपूर्वक भरें</p>
        </div>

        <div class="row justify-content-center mb-3">
          <div class="col-md-6 text-center grid-margin stretch-card">
            <img id="preview"
                 src=""
                 alt="यहाँ मीटर की छवि दिखाई देगी"
                 class="border rounded shadow-sm"
                 style="width: 100%; max-width: 600px; height: 220px; object-fit: cover; display: none;" />
          </div>
        </div>

        <div class="row justify-content-center">
          <div class="col-md-6 grid-margin stretch-card">
            <div class="card shadow-sm border-0">
              <div class="card-body">
            
                <hr>
                <form id="meterForm" class="forms-sample" enctype="multipart/form-data">
                  <div class="form-group row mb-3">
                    <label for="meterPhoto" class="col-sm-4 col-form-label">मीटर की फोटो</label>
                    <div class="col-sm-8">
                      <input type="file" accept="image/*" class="form-control" id="meterPhoto" name="meterPhoto" required />
                    </div>
                  </div>

                  <div class="form-group row mb-3">
                    <label for="odometer" class="col-sm-4 col-form-label">ओडोमीटर रीडिंग</label>
                    <div class="col-sm-8">
                      <input type="number" class="form-control" id="odometer" name="odometer" placeholder="यहाँ रीडिंग दर्ज करें" required />
                    </div>
                  </div>

                  <div class="text-center mt-4">
                    <button type="submit" class="btn btn-primary me-2 px-4">सबमिट करें</button>
                    <button type="reset" class="btn btn-outline-secondary px-4">रद्द करें</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      <% } %>

    <% } else { %>
      <% if (activity && activity.eveningSnap && activity.eveningSnap.reading && activity.eveningSnap.image) { %>
        <div class="alert alert-info text-center shadow-sm rounded">
          <strong>आपने आज शाम की रीडिंग पहले ही भेज दी है।</strong><br>
          कृपया कल की रीडिंग के लिए तैयार रहें।
        </div>
      <% } else { %>
        <div class="text-center mb-4">
          <h5 class="fw-semibold text-primary">शाम की रीडिंग सबमिट करें</h5>
          <p class="text-muted">कृपया नीचे दी गई जानकारी भरें</p>
        </div>

        <div class="row justify-content-center mb-3">
          <div class="col-md-6 text-center grid-margin stretch-card">
            <img id="preview"
                 src=""
                 alt="यहाँ मीटर की छवि दिखाई देगी"
                 class="border rounded shadow-sm"
                 style="width: 100%; max-width: 600px; height: 220px; object-fit: cover; display: none;" />
          </div>
        </div>

        <div class="row justify-content-center">
          <div class="col-md-6 grid-margin stretch-card">
            <div class="card shadow-sm border-0">
              <div class="card-body">
         
                <hr>
                <form id="meterForm" class="forms-sample" enctype="multipart/form-data">
                  <div class="form-group row mb-3">
                    <label for="meterPhoto" class="col-sm-4 col-form-label">मीटर की फोटो</label>
                    <div class="col-sm-8">
                      <input type="file" accept="image/*" class="form-control" id="meterPhoto" name="meterPhoto" required />
                    </div>
                  </div>

                  <div class="form-group row mb-3">
                    <label for="odometer" class="col-sm-4 col-form-label">ओडोमीटर रीडिंग</label>
                    <div class="col-sm-8">
                      <input type="number" class="form-control" id="odometer" name="odometer" placeholder="यहाँ रीडिंग दर्ज करें" required />
                    </div>
                  </div>

                  <div class="text-center mt-4">
                    <button type="submit" class="btn btn-primary me-2 px-4">सबमिट करें</button>
                    <button type="reset" class="btn btn-outline-secondary px-4">रद्द करें</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    <% } %>

    <%- include('./partials/footer.ejs') %>
  </div>
</div>

      <!-- page-body-wrapper ends -->
    </div>
    <!-- container-scroller -->
    <!-- plugins:js -->
    <script src="/assets/vendors/js/vendor.bundle.base.js"></script>
    <script type="module" src="/foreground.js"></script>
    <!-- endinject -->
    <!-- Plugin js for this page -->
    <!-- End plugin js for this page -->
    <!-- inject:js -->
    <script src="/assets/js/off-canvas.js"></script>
    <script src="/assets/js/hoverable-collapse.js"></script>
    <script src="/assets/js/misc.js"></script>
    <script src="/assets/js/settings.js"></script>
    <script src="/assets/js/todolist.js"></script>
    <script src="/custom/speak.js"></script>


    

    <script>

        
        const meterPhotoInput = document.getElementById("meterPhoto");
        const previewImage = document.getElementById("preview");
        if(meterPhotoInput && previewImage){

            meterPhotoInput.addEventListener("change", function () {
          const file = this.files[0];
          if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
              previewImage.src = e.target.result;
              previewImage.style.display = "block";
            };
            reader.readAsDataURL(file);
          } else {
            previewImage.src = "";
            previewImage.style.display = "none";
          }
        });
      
        meterForm.addEventListener("reset", function () {
          previewImage.src = "";
          previewImage.style.display = "none";
        });
        }
        
        
      
        
      </script>
      <script>



const user = <%- JSON.stringify(user) %>;
const bus = <%- JSON.stringify(bus) %>;
const meterForm = document.getElementById("meterForm");
if(meterForm){

    meterForm.addEventListener("submit", async function (e) {
  e.preventDefault();

  const meterPhotoInput = document.getElementById("meterPhoto");
  const odometerInput = document.getElementById("odometer");

  const formData = new FormData();
  formData.append("meterPhoto", meterPhotoInput.files[0]); // 👈 फ़ाइल जोड़ें
  formData.append("odometer", odometerInput.value);        // 👈 ओडोमीटर रीडिंग जोड़ें
  formData.append("busId", user.assignedBus._id);              // 👈 बस की आईडी जोड़ें

  document.getElementById("loader").style.display = "flex";

  try {
    const response = await fetch("/DC/PB/meterReading", {
      method: "POST",
      credentials: "same-origin",

      body: formData, // ✅ Content-Type को खुद ब्राउज़र सेट करेगा
    });

    const result = await response.json();
    if (response.ok) {

        document.getElementById("loader").style.display = "none";
        alert("✅ मीटर रीडिंग सफलतापूर्वक सबमिट कर दी गई है!");
        safeSpeakHindi("मीटर रीडिंग सफलतापूर्वक सबमिट कर दी गई है!")
        setInterval(() => {
            window.location.reload();
        }, 2000);

    } else {
        document.getElementById("loader").style.display = "none";
        alert("❌ सबमिशन विफल हुआ: " + (result.message || "अज्ञात त्रुटि"));
        
        safeSpeakHindi(`सबमिशन विफल हुआ अज्ञात त्रुटि`)
        
    }
} catch (error) {

    document.getElementById("loader").style.display = "none";
    if (
                error.message.includes("Unexpected token '<'") ||
                error.message.includes("position 0") // Firefox/Edge sometimes
              ) {
                window.location.href = "/DC/PB";
                return;
              }
    console.error("Error:", error);
    alert(`❌ नेटवर्क त्रुटि: कृपया विवरण के लिए कंसोल देखें। ${error.message}`);
    safeSpeakHindi(`नेटवर्क त्रुटि: कृपया विवरण के लिए कंसोल देखें।`)
  }
});



}


window.onload = function () {
          document.getElementById("loader").style.display = "none";
        };


      </script>
      
      
      
    
 
 

  </body>
</html>
