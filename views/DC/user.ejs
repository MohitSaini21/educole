<!DOCTYPE html>
<html lang="hi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>बस एक्सेस ब्लॉक</title>
    <style>
      /* Base Reset */
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        font-family: "Poppins", "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background-color: #121417; /* very dark background like your dashboard */
        color: #e0e0e0; /* light gray text */
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
      }

      .card {
        background-color: #1e1e2f; /* dark card background */
        padding: 32px 28px;
        border-radius: 12px;
        box-shadow: 0 0 20px rgba(255, 202, 40, 0.3); /* subtle gold glow */
        max-width: 400px;
        width: 100%;
        text-align: center;
        transition: transform 0.25s ease;
      }

      .card:hover {
        transform: translateY(-6px);
        box-shadow: 0 0 28px rgba(255, 202, 40, 0.5);
      }

      .profile-img {
        width: 100px;
        height: 100px;
        object-fit: cover;
        border-radius: 50%;
        margin-bottom: 22px;
        border: 3px solid #ffc107; /* dashboard yellow */
        box-shadow: 0 0 8px rgba(255, 193, 7, 0.6);
        transition: box-shadow 0.3s ease;
      }

      .profile-img:hover {
        box-shadow: 0 0 14px rgba(255, 193, 7, 0.9);
      }

      .user-name {
        font-size: 24px;
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 6px;
      }

      .user-phone {
        font-size: 16px;
        color: #b0b0b0;
        margin-bottom: 22px;
        font-weight: 500;
      }

      .warning-msg {
        font-size: 16px;
        color: #ff6f61; /* coral red for warning */
        font-weight: 600;
        background-color: #2a1e1e; /* dark redish background */
        padding: 16px 20px;
        border-radius: 10px;
        border: 1.5px solid #ff3b30;
        box-shadow: inset 0 0 10px #ff7965;
        margin-bottom: 32px;
        line-height: 1.4;
      }

      .back-btn {
        background-color: #ffc107; /* gold */
        color: #1e1e2f; /* dark text */
        font-weight: 700;
        padding: 14px 36px;
        border: none;
        border-radius: 28px;
        cursor: pointer;
        font-size: 16px;
        box-shadow: 0 5px 14px rgba(255, 193, 7, 0.6);
        transition: background-color 0.3s ease, box-shadow 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        user-select: none;
      }

      .back-btn:hover {
        background-color: #ffca28;
        box-shadow: 0 8px 22px rgba(255, 202, 40, 0.9);
      }

      @media (max-width: 480px) {
        .card {
          padding: 24px 20px;
          max-width: 90vw;
        }

        .profile-img {
          width: 80px;
          height: 80px;
          margin-bottom: 18px;
          border-width: 2.5px;
        }

        .user-name {
          font-size: 20px;
          margin-bottom: 4px;
        }

        .user-phone {
          font-size: 14px;
          margin-bottom: 20px;
        }

        .warning-msg {
          font-size: 14px;
          padding: 14px 16px;
          margin-bottom: 28px;
        }

        .back-btn {
          padding: 12px 28px;
          font-size: 15px;
        }
      }
    </style>
  </head>
  <body>
    <div class="card" role="alert" aria-live="assertive" aria-atomic="true">
      <img
        src="<%= user.profilePhoto %>"
        alt="User Profile Photo"
        class="profile-img"
      />
      <div class="user-name" aria-label="User Name"><%= user.name %></div>
      <div class="user-phone" aria-label="User Phone Number">फोन: <%= user.phone %></div>
      <div class="warning-msg" aria-label="Warning Message">
        🛑 यह बस पहले से ही एक उपयोगकर्ता द्वारा उपयोग की जा रही है। कृपया उसे पहले
        लॉगआउट करने को कहें।
      </div>
      <button
        class="back-btn"
        onclick="goBack()"
        aria-label="Go back to previous page"
      >
        🔙 वापस जाएँ
      </button>
    </div>

    <script>
      function goBack() {
        window.history.back();
      }
    </script>
  </body>
</html>
