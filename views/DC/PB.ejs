    <style>
.icon-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
  gap: 16px;
  justify-items: center;
  margin-top: 20px;
}

.action-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 100px;
  height: 100px;
  border-radius: 12px;
  background-color: #f1c40f;
  color: white;
  text-decoration: none;
  transition: all 0.2s ease;
  font-size: 16px;
  box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

.action-icon i {
  font-size: 26px;
  margin-bottom: 8px;
}

.action-icon span {
  font-size: 14px;
  font-weight: 500;
  text-align: center;
}

.action-icon:hover {
  background-color: #f1c40f;
  transform: scale(1.05);
}

/* Mobile responsive tweaks */
@media (max-width: 576px) {
  .action-icon {
    max-width: 100%;
    height: 90px;
  }

  .action-icon i {
    font-size: 22px;
  }

  .action-icon span {
    font-size: 13px;
  }
}


    </style>
