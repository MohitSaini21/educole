  <script>

const user = <%- JSON.stringify(user) %>;
const bus= <%- JSON.stringify(bus) %>;
  document.addEventListener("DOMContentLoaded", async () => {
    const form = document.getElementById("odometerForm");
    const input = document.getElementById("odometerReading");

    form.addEventListener("submit", async (e) => {
      e.preventDefault(); // ✅ prevents page refresh

      const reading = input.value;

      document.getElementById("loader").style.display = "flex";

      try {
        const response = await fetch("/DC/PB/odometer", {
          method: "POST",
          credentials: "include", // 👈 Important to send cookies
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ odometerReading: reading}),
        });

        const result= await response.json()
        document.getElementById("loader").style.display = "none";
        document.getElementById("odoReading").innerText=`दूरी तय की गई : ${reading} कि.मी.`
        let  message = result.message.slice(2); // pehle ke 2 character (🔇) hata do
        safeSpeakHindi(message)
        alert(result.message)
     
      
      } catch (error) {
        document.getElementById("loader").style.display = "none";
        console.error(error);
        if (
  error.message.includes("Unexpected token '<'") ||
  error.message.includes("position 0") // Firefox/Edge sometimes
) {
  window.location.href = "/DC";
  return;
}
       
        document.getElementById("loader").style.display = "none";
        alert("❌ Server or network error.");
        safeSpeakHindi("Server or network error.");
      }
    });
  });

  // haldine emeregency

  
  function handleEmergencyClick() {

safeSpeakHindi("क्या आप वाकई आपातकालीन सूचना भेजना चाहते हैं ");
const confirmEmergency = confirm(`⚠️ क्या आप वाकई आपातकालीन सूचना भेजना चाहते हैं? ${bus.busNumber}`);

if (!confirmEmergency) {
safeSpeakHindi("आपातकालीन कार्रवाई रद्द कर दी गई है।");
alert("❌ आपातकालीन कार्रवाई रद्द कर दी गई है।");
return;
}

// 📦 Optional: आप चाहें तो ड्राइवर/बस की जानकारी यहाँ जोड़ सकते हैं
const emergencyData = {
timestamp: new Date().toISOString(),



};

// 🚀 Server को सूचना भेजना
document.getElementById("loader").style.display = "flex";



fetch('/DC/PB/emergencyAlert', {
  method: 'POST',
  credentials: "include", // 👈 Important to send cookies like auth token
  headers: {
    'Content-Type': 'application/json'
  },
  body: JSON.stringify(emergencyData)
})
.then(async (response) => {
  const text = await response.text(); // Read response as plain text

  // 🔍 Detect if server redirected to login or sent HTML
  if (text.includes("<!DOCTYPE html>") || text.includes("<html")) {
    window.location.href = "/DC";
    return;
  }

  // ✅ Try parsing JSON safely
  let data;
  try {
    data = JSON.parse(text);
  } catch (err) {
    console.error("❌ JSON parse error:", err);
    alert("❌ Unexpected response from server.");
    return;
  }

  // 🎯 Check response status
  if (response.ok) {
    document.getElementById("loader").style.display = "none";
    safeSpeakHindi("सूचना भेज दी गई है। प्रशासन जल्द ही संपर्क करेगा।");
    alert("✅ सूचना भेज दी गई है। प्रशासन जल्द ही संपर्क करेगा।");
  } else {
    console.error("❌ Server responded with an error:", data);
    alert("❌ कुछ गलत हुआ। कृपया पुनः प्रयास करें।");
  }
})
.catch((error) => {
  document.getElementById("loader").style.display = "none";

  if (
    error.message.includes("Unexpected token '<'") ||
    error.message.includes("position 0")
  ) {
    window.location.href = "/DC";
    return;
  }

  console.error("❌ नेटवर्क त्रुटि:", error);
  safeSpeakHindi("सूचना भेजने में समस्या आई। कृपया पुनः प्रयास करें।");
  alert("❌ सूचना भेजने में समस्या आई। कृपया पुनः प्रयास करें।");
});

  }

  window.onload = function () {
    document.getElementById("loader").style.display = "none";
  };


  document.querySelectorAll('.collapsible-header').forEach(header => {
    header.addEventListener('click', () => {
      const content = header.nextElementSibling;
      content.classList.toggle('open');
    });
  });



  
 
  
   
  

  
  
  
  </script>

