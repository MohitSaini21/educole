<nav class="navbar p-0 fixed-top d-flex flex-row">
  <div class="navbar-menu-wrapper flex-grow d-flex align-items-stretch">
    <button
      class="navbar-toggler navbar-toggler align-self-center"
      type="button"
      data-toggle="minimize"
    >
      <span class="mdi mdi-menu"></span>
    </button>
    <ul class="navbar-nav w-100">
      <li class="nav-item w-100">
        <form class="nav-link mt-2 mt-md-0 d-none d-lg-flex search">
          <input
            type="text"
            class="form-control"
            value="<%=user.name  %> (<%=user.role  %>)"
            placeholder="Search products"
          />
        </form>
      </li>
    </ul>
    <ul class="navbar-nav navbar-nav-right">
      <li class="nav-item nav-settings d-none d-lg-block">
        <a class="nav-link" href="#">
          <i class="mdi mdi-view-grid" onclick="goFullScreen()"></i>
        </a>
      </li>
      <li class="nav-item dropdown border-left">
        <a
          class="nav-link count-indicator dropdown-toggle"
          id="notificationDropdown"
          href="#"
          data-toggle="dropdown"
        >
          <!-- बस आइकन -->
          <i class="mdi mdi-bus"></i>
        </a>
        <div
          class="dropdown-menu dropdown-menu-right navbar-dropdown preview-list"
          aria-labelledby="notificationDropdown"
        >
          <h6 class="p-3 mb-0">बस जानकारी</h6>
          <div class="dropdown-divider"></div>

          <!-- बस नंबर सूचना -->
          <a class="dropdown-item preview-item">
            <div class="preview-thumbnail">
              <div class="preview-icon bg-dark rounded-circle">
                <i class="mdi mdi-calendar text-success"></i>
              </div>
            </div>
            <div class="preview-item-content">
              <p class="preview-subject mb-1">
                बस नंबर: <%= user.assignedBus.busNumber %>
              </p>
              <p class="text-muted ellipsis mb-0">
                कृपया अपनी बस का नंबर याद रखें।
              </p>
            </div>
          </a>

          <div class="dropdown-divider"></div>

          <!-- रूट सूचना -->
          <a class="dropdown-item preview-item">
            <div class="preview-thumbnail">
              <div class="preview-icon bg-dark rounded-circle">
                <i class="mdi mdi-map-marker text-danger"></i>
              </div>
            </div>
            <div class="preview-item-content">
              <p class="preview-subject mb-1">
                रूट : <%= user.assignedBus.route %>
              </p>
              <p class="text-muted ellipsis mb-0">आपका निर्धारित मार्ग</p>
            </div>
          </a>

          <div class="dropdown-divider"></div>
          <a class="dropdown-item preview-item">
            <div class="preview-thumbnail">
              <div class="preview-icon bg-dark rounded-circle">
                <!-- Distance icon -->
                <i class="mdi mdi-map text-primary"></i>
              </div>
            </div>
            <div class="preview-item-content">
              <p class="preview-subject mb-1" id="odoReading">
                दूरी तय की गई : <%= user.assignedBus.distanceTravelled %> कि.मी.
              </p>
              <p class="text-muted ellipsis mb-0">
                कृपया रोज़ाना अपना ओडोमीटर अपडेट रखें
              </p>
            </div>
          </a>

          <div class="dropdown-divider"></div>
          <a class="dropdown-item preview-item">
            <div class="preview-thumbnail">
              <div class="preview-icon bg-dark rounded-circle">
                <% if (user.assignedBus.status === 'operational') { %>
                <i class="mdi mdi-bus"></i>
                <% } else { %>
                <i class="mdi mdi-bus"></i>
                <% } %>
              </div>
            </div>
            <div class="preview-item-content">
              <p class="preview-subject mb-1">
                बस की स्थिति : <% if (user.assignedBus.status === 'Operational')
                { %> संचालित (चालू) <% } else { %> सेवा में नहीं (बंद) <% } %>
              </p>
              <p class="text-muted ellipsis mb-0">
                यही फ़ैक्टर ज़िम्मेदार है कि आप लाइव जा सकते हैं या नहीं
              </p>
            </div>
          </a>
        </div>
      </li>

      <li class="nav-item dropdown">
        <a
          class="nav-link"
          id="profileDropdown"
          href="#"
          data-toggle="dropdown"
        >
          <div class="navbar-profile">
            <img
              class="img-xs rounded-circle"
              src="<%=user.profilePhoto  %>"
              alt=""
            />
            <p class="mb-0 d-none d-sm-block navbar-profile-name">
              <%=user.name%>
            </p>

            <i class="mdi mdi-menu-down d-none d-sm-block"></i>
          </div>
        </a>
        <div
          class="dropdown-menu dropdown-menu-right navbar-dropdown preview-list"
          aria-labelledby="profileDropdown"
        >
          <h6 class="p-3 mb-0">प्रोफ़ाइल</h6>
          <div class="dropdown-divider"></div>

          <div class="dropdown-divider"></div>
          <a class="dropdown-item preview-item">
            <div class="preview-thumbnail">
              <div class="preview-icon bg-dark rounded-circle">
                <i class="mdi mdi-logout text-danger"></i>
              </div>
            </div>
            <div class="preview-item-content">
              <p class="preview-subject mb-1" onclick="Redirect()">
                लॉगआउट करें (Log out)
              </p>
            </div>
          </a>
          <div class="dropdown-divider"></div>
        </div>
      </li>
    </ul>
    <button
      class="navbar-toggler navbar-toggler-right d-lg-none align-self-center"
      type="button"
      data-toggle="offcanvas"
    >
      <span class="mdi mdi-format-line-spacing"></span>
    </button>
  </div>
</nav>

<script>
  function Redirect() {
    // उपयोगकर्ता से पुष्टि (confirmation) पूछें
    var userConfirmed = confirm("क्या आप वाकई लॉगआउट करना चाहते हैं?");

    // अगर उपयोगकर्ता ने 'ठीक है' पर क्लिक किया
    if (userConfirmed) {
      window.location.href = "/DC/logout"; // अपने लॉगआउट लिंक से बदलें
    } else {
      alert("लॉगआउट रद्द कर दिया गया");
    }
  }
</script>
